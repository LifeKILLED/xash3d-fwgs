#version 460 core
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_ray_query: require
#extension GL_EXT_control_flow_attributes : require

#define GLSL
#include "ray_interop.h"
#undef GLSL

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 2) uniform UBO { UniformBuffer ubo; } ubo;
layout(set = 0, binding = 6) uniform sampler2D textures[MAX_TEXTURES];

layout(set = 0, binding = 7) readonly buffer SBOLights { LightsMetadata m; } lights;
layout(set = 0, binding = 8, align = 1) readonly buffer UBOLightClusters {
	LightCluster clusters_[MAX_LIGHT_CLUSTERS];
} light_grid;

layout(set = 0, binding = 10, rgba16f) uniform readonly image2D reflection_throughput;
layout(set = 0, binding = 11, rgba32f) uniform readonly image2D reflection_hit_pos;
layout(set = 0, binding = 12, rgba16f) uniform readonly image2D reflection_normals_gs;
layout(set = 0, binding = 13, rgba8) uniform readonly image2D reflection_material_rmxx;
layout(set = 0, binding = 14, rgba8) uniform readonly image2D reflection_base_color_a;
layout(set = 0, binding = 15, rgba16f) uniform readonly image2D reflection_view_dir;
layout(set = 0, binding = 16, rgba16f) uniform readonly image2D reflection_emissive;
layout(set = 0, binding = 17, rgba32f) uniform readonly image2D prev_reflection_hit_pos;

layout(set = 0, binding = 20, rgba16f) uniform writeonly image2D out_reflection_ris_poly_candidate;
layout(set = 0, binding = 21, rgba32f) uniform writeonly image2D out_temporal_reflection_ris_poly_reservoir;
layout(set = 0, binding = 22, rgba32f) uniform readonly image2D prev_temporal_reflection_ris_poly_reservoir;
layout(set = 0, binding = 23, rgba32f) uniform readonly image2D position_t;
layout(set = 0, binding = 24, rgba16f) uniform readonly image2D normals_gs;
layout(set = 0, binding = 25, rgba32f) uniform readonly image2D geometry_prev_position;
layout(set = 0, binding = 26, rgba16f) uniform readonly image2D prev_temporal_asvgf_reproj_depth;
layout(set = 0, binding = 29, rgba32f) uniform readonly image2D regir_onion_poly;
layout(set = 0, binding = 30, std430) readonly buffer ModelHeaders { ModelHeader a[]; } model_headers;
layout(set = 0, binding = 31, std430) readonly buffer Kusochki { Kusok a[]; } kusochki;
layout(set = 0, binding = 32, std430) readonly buffer Indices { uint16_t a[]; } indices;
layout(set = 0, binding = 33, std430) readonly buffer Vertices { Vertex a[]; } vertices;

#define RAY_QUERY
#define RIS_INIT_PASS 1
#define LIGHT_POLYGON 1
#define REGIR_ONION_IMAGE regir_onion_poly
#define RIS_POLY_OUT_CANDIDATE_IMAGE out_reflection_ris_poly_candidate
#define RIS_POLY_OUT_TEMPORAL_RESERVOIR_IMAGE out_temporal_reflection_ris_poly_reservoir
#define RIS_POLY_PREV_TEMPORAL_RESERVOIR_IMAGE prev_temporal_reflection_ris_poly_reservoir
#include "reflection_ris_common.glsl"
#include "light_ris.glsl"

void main()
{
	const ivec2 ris_pix = ivec2(gl_GlobalInvocationID.xy);
	if (risInitWorkgroupOutsideBounds()) {
		return;
	}
	ivec2 pix;
	const bool surface_selected = risSelectReservoirSurfacePixel(ris_pix, pix);

	rand01_state = ubo.ubo.random_seed
		+ uint(pix.x) * 1833u
		+ uint(pix.y) * 31337u
		+ 0x72706f6cu;

	vec3 P = vec3(0.0);
	vec3 geometry_N = vec3(0.0, 0.0, 1.0);
	vec3 shading_N = geometry_N;
	vec3 V = vec3(0.0, 0.0, 1.0);
	vec3 throughput = vec3(0.0);
	vec3 emissive_radiance = vec3(0.0);
	MaterialProperties material;
	material.base_color = vec3(0.0);
	material.metalness = 0.0;
	material.roughness = 1.0;
	bool surface_loaded = false;
	if (surface_selected) {
		surface_loaded = reflectionRisLoadSurface(pix, P, geometry_N, shading_N, V, material, throughput, emissive_radiance);
	}
	const bool surface_active = surface_selected && surface_loaded;
	computeLightingRISInit(P, geometry_N, shading_N, V, material, ris_pix, pix, surface_active);
}
