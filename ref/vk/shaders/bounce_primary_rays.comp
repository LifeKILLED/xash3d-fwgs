#version 460 core
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_ray_query: require

#include "debug.glsl"

#define GLSL
#include "ray_interop.h"
#undef GLSL

#define RAY_BOUNCE
#define RAY_QUERY
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1) uniform accelerationStructureEXT tlas;

layout(set = 0, binding = 2) uniform UBO { UniformBuffer ubo; } ubo;
layout(set = 0, binding = 6) uniform sampler2D textures[MAX_TEXTURES];
layout(set = 0, binding = 7) uniform samplerCube skybox;

layout(set = 0, binding = 10, rgba32f) uniform readonly image2D position_t;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D normals_gs;
layout(set = 0, binding = 20, rgba16f) uniform writeonly image2D out_bounce_throughput;
layout(set = 0, binding = 21, rgba32f) uniform writeonly image2D out_bounce_hit_pos;
layout(set = 0, binding = 22, rgba16f) uniform writeonly image2D out_bounce_normals_gs;
layout(set = 0, binding = 23, rgba8) uniform writeonly image2D out_bounce_material_rmxx;
layout(set = 0, binding = 24, rgba8) uniform writeonly image2D out_bounce_base_color_a;
layout(set = 0, binding = 25, rgba16f) uniform writeonly image2D out_bounce_view_dir;
layout(set = 0, binding = 26, rgba16f) uniform writeonly image2D out_bounce_emissive;
layout(set = 0, binding = 27, rgba32f) uniform writeonly image2D out_first_bounce_direction;
layout(set = 0, binding = 28, rgba32f) uniform writeonly image2D out_bounce_ray_origin_length;

layout(set = 0, binding = 30, std430) readonly buffer ModelHeaders { ModelHeader a[]; } model_headers;
layout(set = 0, binding = 31, std430) readonly buffer Kusochki { Kusok a[]; } kusochki;
layout(set = 0, binding = 32, std430) readonly buffer Indices { uint16_t a[]; } indices;
layout(set = 0, binding = 33, std430) readonly buffer Vertices { Vertex a[]; } vertices;

#include "ray_primary_common.glsl"
#include "ray_primary_hit.glsl"
#include "noise.glsl"
#include "brdf.glsl"
#define BOUNCE_RIS_COORDS_ONLY 1
#include "bounce_ris_common.glsl"
#undef BOUNCE_RIS_COORDS_ONLY
#include "skybox.glsl"

struct MaterialEx {
	vec3 geometry_normal;
	vec3 shading_normal;
};

const float kRayNormalOffsetFudge = 0.01;

vec3 offsetBounceRayOrigin(vec3 hit_pos, vec3 geometry_normal, vec3 bounce_dir, float eps)
{
	const float normal_sign = dot(geometry_normal, bounce_dir) >= 0.0 ? 1.0 : -1.0;
	return hit_pos + geometry_normal * (eps * normal_sign);
}

bool getBounceHit(vec3 origin, vec3 direction, inout RayPayloadPrimary payload)
{
	rayQueryEXT rq;
	const uint flags = 0
		| gl_RayFlagsCullFrontFacingTrianglesEXT
		;

	const float L = 10000.0;
	rayQueryInitializeEXT(rq, tlas, flags, GEOMETRY_BIT_OPAQUE | GEOMETRY_BIT_ALPHA_TEST, origin, 0.0, direction, L);
	while (rayQueryProceedEXT(rq)) {
		if (0 != (rayQueryGetRayFlagsEXT(rq) & gl_RayFlagsOpaqueEXT)) {
			continue;
		}

		const MiniGeometry geom = readCandidateMiniGeometry(rq);
		const uint tex_base_color = getKusok(geom.kusok_index).material.tex_base_color;
		const vec4 texture_color = texture(textures[nonuniformEXT(tex_base_color)], geom.uv);

		const float alpha_mask_threshold = 0.1;
		if (texture_color.a >= alpha_mask_threshold) {
			rayQueryConfirmIntersectionEXT(rq);
		}
	}

	if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
		payload.hit_t = vec4(vec3(0.0), L);
		payload.emissive.rgb = sampleSkybox(direction);
		return false;
	}

	payload.emissive.rgb = vec3(0.0);
	primaryRayHit(rq, payload);
	if (payload.hit_t.w < 0.0) {
		payload.hit_t.w = -payload.hit_t.w;
		return false;
	}

	return true;
}

void clearBounceSample(ivec2 pix)
{
	imageStore(out_bounce_throughput, pix, vec4(0.0));
	imageStore(out_bounce_hit_pos, pix, vec4(0.0));
	imageStore(out_bounce_normals_gs, pix, vec4(0.0));
	imageStore(out_bounce_material_rmxx, pix, vec4(0.0));
	imageStore(out_bounce_base_color_a, pix, vec4(0.0));
	imageStore(out_bounce_view_dir, pix, vec4(0.0));
	imageStore(out_bounce_emissive, pix, vec4(0.0));
	imageStore(out_bounce_ray_origin_length, pix, vec4(0.0));
}

void storeBounceHit(
	ivec2 pix,
	RayPayloadPrimary payload,
	vec3 throughput,
	int brdf_type,
	vec3 emissive_radiance,
	vec3 view_dir,
	vec3 ray_origin,
	float ray_length)
{
	imageStore(out_bounce_throughput, pix, vec4(throughput, float(brdf_type)));
	imageStore(out_bounce_hit_pos, pix, payload.hit_t);
	imageStore(out_bounce_normals_gs, pix, payload.normals_gs);
	imageStore(out_bounce_material_rmxx, pix, payload.material_rmxx);
	imageStore(out_bounce_base_color_a, pix, LINEARtoSRGB(payload.base_color_a));
	imageStore(out_bounce_view_dir, pix, vec4(view_dir, 0.0));
	imageStore(out_bounce_emissive, pix, vec4(emissive_radiance, 0.0));
	imageStore(out_bounce_ray_origin_length, pix, vec4(ray_origin, ray_length));
}

void storeBounceMiss(
	ivec2 pix,
	vec3 throughput,
	int brdf_type,
	vec3 emissive_radiance,
	vec3 view_dir,
	vec3 ray_origin,
	float ray_length)
{
	imageStore(out_bounce_throughput, pix, vec4(throughput, float(brdf_type)));
	imageStore(out_bounce_hit_pos, pix, vec4(0.0));
	imageStore(out_bounce_normals_gs, pix, vec4(0.0));
	imageStore(out_bounce_material_rmxx, pix, vec4(0.0));
	imageStore(out_bounce_base_color_a, pix, vec4(0.0));
	imageStore(out_bounce_view_dir, pix, vec4(view_dir, 0.0));
	imageStore(out_bounce_emissive, pix, vec4(emissive_radiance, 0.0));
	imageStore(out_bounce_ray_origin_length, pix, vec4(ray_origin, ray_length));
}

void main()
{
	const ivec2 local_pix = ivec2(gl_GlobalInvocationID.xy);
	const ivec2 lane_size = bounceRisLaneSize();
	if (any(greaterThanEqual(local_pix, lane_size))) {
		return;
	}

	for (uint lane = 0u; lane < BOUNCE_RIS_DIFFUSE_LANE_COUNT; ++lane) {
		clearBounceSample(bounceRisAtlasPixel(local_pix, lane));
	}
	const ivec2 primary_pix = local_pix * 2;

	imageStore(out_first_bounce_direction, local_pix, vec4(0.0));

	if ((ubo.ubo.renderer_flags & RENDERER_FLAG_DISABLE_GI) != 0 ||
		any(greaterThanEqual(primary_pix, ubo.ubo.res))) {
		return;
	}

	const vec4 pos_t = imageLoad(position_t, primary_pix);
	if (pos_t.w <= 0.0) {
		return;
	}

	rand01_state = ubo.ubo.random_seed
		+ uint(local_pix.x) * 1833u
		+ uint(local_pix.y) * 31337u
		+ 12u;

	const vec4 packed_normal = imageLoad(normals_gs, primary_pix);

	MaterialEx mat;
	mat.geometry_normal = normalDecode(packed_normal.xy);
	mat.shading_normal = normalDecode(packed_normal.zw);

	vec3 pos = pos_t.xyz;
	const vec3 first_pos = pos;
	for (uint bounce = 0u; bounce < BOUNCE_RIS_DIFFUSE_LANE_COUNT; ++bounce) {
		const ivec2 pix = bounceRisAtlasPixel(local_pix, bounce);
		vec3 throughput = vec3(1.0);
		const vec2 rnd = vec2(rand01(), rand01());
		vec3 bounce_direction = sampleCosineHemisphereAroundVectorUnnormalized(rnd, mat.shading_normal);
		if (dot(bounce_direction, bounce_direction) < 1e-5 ||
			dot(bounce_direction, mat.geometry_normal) <= 0.0 ||
			any(isnan(bounce_direction))) {
			return;
		}
		bounce_direction = normalize(bounce_direction);
		const int brdf_type = BRDF_TYPE_DIFFUSE;

		RayPayloadPrimary payload;
		payload.base_color_a = vec4(0.0);
		payload.emissive = vec4(0.0);
		payload.material_rmxx = vec4(0.0);
		payload.normals_gs = vec4(0.0);
		payload.hit_t = vec4(0.0);
		payload.prev_pos_t = vec4(0.0);

		const vec3 bounce_ray_origin = offsetBounceRayOrigin(pos, mat.geometry_normal, bounce_direction, kRayNormalOffsetFudge);
		const bool did_hit = getBounceHit(bounce_ray_origin, bounce_direction, payload);

		if (!did_hit) {
			storeBounceMiss(
				pix,
				throughput,
				brdf_type,
				payload.emissive.rgb,
				-bounce_direction,
				bounce_ray_origin,
				payload.hit_t.w);
			return;
		}

		storeBounceHit(
			pix,
			payload,
			throughput,
			brdf_type,
			vec3(0.0),
			-bounce_direction,
			bounce_ray_origin,
			payload.hit_t.w);

		if (bounce == BOUNCE_RIS_DIFFUSE_LANE_0) {
			const vec3 segment = payload.hit_t.xyz - first_pos;
			imageStore(out_first_bounce_direction, local_pix, vec4(segment, 0.0));
		}

		pos = payload.hit_t.xyz;
		mat.geometry_normal = normalDecode(payload.normals_gs.xy);
		mat.shading_normal = normalDecode(payload.normals_gs.zw);
	}
}
