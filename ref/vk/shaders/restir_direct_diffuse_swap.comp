#version 460 core
#extension GL_GOOGLE_include_directive : require

#define GLSL
#include "ray_interop.h"
#undef GLSL

#include "denoiser_config.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D diffuse_direct_restir;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D diffuse_direct_restir_brightness_raw;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D diffuse_direct_restir_brightness;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D diffuse_direct_restir_wish;
layout(set = 0, binding = 4, rgba32f) uniform writeonly image2D out_diffuse_direct_restir_swapped;
layout(set = 0, binding = 5) uniform UBO { UniformBuffer ubo; } ubo;
layout(set = 0, binding = 6, rgba32f) uniform writeonly image2D out_temporal_res_diffuse;

#define WISH_DEAD_ZONE 0.02

bool in_bounds(ivec2 p, ivec2 res) {
    return all(greaterThanEqual(p, ivec2(0))) && all(lessThan(p, res));
}

ivec2 decode_coord(vec2 coord_f) {
    return ivec2(floor(coord_f + vec2(0.5)));
}

ivec2 select_wish(ivec2 pix, ivec2 res) {
    const float center_raw = imageLoad(diffuse_direct_restir_brightness_raw, pix).r;
    const float center_blur = imageLoad(diffuse_direct_restir_brightness, pix).r;
    const float denom = max(abs(center_blur), 1e-6);
    const float rel_diff = (center_raw - center_blur) / denom;

    if (abs(rel_diff) <= WISH_DEAD_ZONE) {
        return pix;
    }

    const vec4 wish = imageLoad(diffuse_direct_restir_wish, pix);
    const ivec2 selected = (rel_diff > 0.0) ? decode_coord(wish.xy) : decode_coord(wish.zw);
    if (!in_bounds(selected, res)) {
        return pix;
    }

    return selected;
}

void write_stabilized_reservoir(ivec2 pix, vec4 reservoir) {
    imageStore(out_diffuse_direct_restir_swapped, pix, reservoir);
    imageStore(out_temporal_res_diffuse, pix, reservoir);
}

void main() {
    const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 res = ivec2(vec2(ubo.ubo.res) * ubo.ubo.resScale);
    if (any(greaterThanEqual(pix, res))) {
        return;
    }

#if !DENOISER_STABILIZE_DIFFUSE_RESERVOIRS
    write_stabilized_reservoir(pix, imageLoad(diffuse_direct_restir, pix));
    return;
#endif

    const ivec2 wish = select_wish(pix, res);
    if (all(equal(wish, pix))) {
        write_stabilized_reservoir(pix, imageLoad(diffuse_direct_restir, pix));
        return;
    }

    const ivec2 back_wish = select_wish(wish, res);
    if (!all(equal(back_wish, pix))) {
        write_stabilized_reservoir(pix, imageLoad(diffuse_direct_restir, pix));
        return;
    }

    write_stabilized_reservoir(pix, imageLoad(diffuse_direct_restir, wish));
}
