#version 460
layout(local_size_x=8, local_size_y=8) in;
#include "restir_common.glsl"

layout(binding=1, rgba16f) uniform image2D gPosCur;
layout(binding=2, rgba16f) uniform image2D gNormCur;
layout(binding=3, rgba16f) uniform image2D gViewCur;

layout(binding=4, rgba16f) uniform image2D gPosPrev;
layout(binding=5, rgba16f) uniform image2D gNormPrev;

layout(binding=6, rgba32f) uniform image2D resDiffuseCur;
layout(binding=7, rgba32f) uniform image2D resSpecularCur;
layout(binding=8, rgba32f) uniform image2D resDiffusePrev;
layout(binding=9, rgba32f) uniform image2D resSpecularPrev;

layout(binding=10, rgba16f) uniform image2D outColorDiffuse;
layout(binding=11, rgba16f) uniform image2D outColorSpecular;
layout(binding=12, r16f)    uniform image2D confDiffuse;
layout(binding=13, r16f)    uniform image2D confSpecular;

vec3 shadeReservoir(Reservoir r, vec3 P, vec3 N, vec3 V, float rough, bool isSpecular){
    Light L = lights[r.lightIndex];
    vec3 wi = normalize(L.position - P);
    if(isSpecular){
        float spec = pow(max(dot(reflect(-wi,N),V),0.0), mix(2.0,64.0,1.0-rough));
        return L.color * L.intensity * spec;
    }else{
        float NdL = max(dot(N,wi),0.0);
        return L.color * L.intensity * NdL;
    }
}

float lightChangeConf(vec3 cur, vec3 prev){ float diff=length(cur-prev)/max(length(prev),1e-4); return exp(-diff*4.0); }

void processLobe(ivec2 px, bool isSpecular, out vec3 outShade, out float outConf){
    vec3 Pc = imageLoad(gPosCur, px).xyz;
    vec3 Nc = normalize(imageLoad(gNormCur, px).xyz);
    vec4 Vd = imageLoad(gViewCur, px);
    vec3 V = normalize(Vd.xyz);
    float rough = Vd.w;

    vec3 Pp = imageLoad(gPosPrev, px).xyz;
    vec3 Np = normalize(imageLoad(gNormPrev, px).xyz);

    Reservoir rCur = isSpecular ? loadReservoir(resSpecularCur, px) : loadReservoir(resDiffuseCur, px);
    Reservoir rPrev = isSpecular ? loadReservoir(resSpecularPrev, px) : loadReservoir(resDiffusePrev, px);

    vec3 shadeCur = shadeReservoir(rCur, Pc, Nc, V, rough, isSpecular);
    vec3 shadePrev = shadeReservoir(rPrev, Pp, Np, V, rough, isSpecular);

    outShade = shadeCur;
    outConf = lightChangeConf(shadeCur, shadePrev);

    if(isSpecular) imageStore(confSpecular, px, vec4(outConf,0,0,0));
    else imageStore(confDiffuse, px, vec4(outConf,0,0,0));
}

void main(){
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    vec3 shadeD; float confD; processLobe(px,false,shadeD,confD);
    vec3 shadeS; float confS; processLobe(px,true,shadeS,confS);
    imageStore(outColorDiffuse, px, vec4(shadeD,1));
    imageStore(outColorSpecular, px, vec4(shadeS,1));
}
