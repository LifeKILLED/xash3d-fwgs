#version 460 core
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require

#include "debug.glsl"

#define GLSL
#include "ray_interop.h"
#undef GLSL

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 2) uniform UBO { UniformBuffer ubo; } ubo;

layout(set = 0, binding = 10, rgba16f) uniform readonly image2D bounce_throughput;
layout(set = 0, binding = 11, rgba32f) uniform readonly image2D bounce_hit_pos;
layout(set = 0, binding = 12, rgba16f) uniform readonly image2D bounce_normals_gs;
layout(set = 0, binding = 13, rgba8) uniform readonly image2D bounce_material_rmxx;
layout(set = 0, binding = 14, rgba8) uniform readonly image2D bounce_base_color_a;
layout(set = 0, binding = 15, rgba16f) uniform readonly image2D bounce_view_dir;
layout(set = 0, binding = 16, rgba16f) uniform readonly image2D bounce_emissive;
layout(set = 0, binding = 17, rgba16f) uniform readonly image2D bounce_light_poly_diffuse;
layout(set = 0, binding = 18, rgba16f) uniform readonly image2D bounce_light_poly_specular;
layout(set = 0, binding = 19, rgba16f) uniform readonly image2D bounce_light_point_diffuse;
layout(set = 0, binding = 20, rgba16f) uniform readonly image2D bounce_light_point_specular;

layout(set = 0, binding = 21, rgba16f) uniform writeonly image2D out_indirect_diffuse;

#include "bounce_ris_common.glsl"

void accumulateBounceLane(ivec2 atlas_pix, inout vec3 path_throughput, inout vec3 indirect_diffuse)
{
	const vec3 stage_throughput = imageLoad(bounce_throughput, atlas_pix).rgb;
	path_throughput *= stage_throughput;

	const vec3 emissive_radiance = imageLoad(bounce_emissive, atlas_pix).rgb;
	indirect_diffuse += path_throughput * emissive_radiance;

	vec3 P;
	vec3 geometry_N;
	vec3 shading_N;
	vec3 V;
	vec3 throughput;
	vec3 unused_emissive;
	MaterialProperties material;
	const bool surface_active = bounceRisLoadSurface(atlas_pix, P, geometry_N, shading_N, V, material, throughput, unused_emissive);
	if (!surface_active) {
		return;
	}

	const vec3 diffuse_light =
		imageLoad(bounce_light_poly_diffuse, atlas_pix).rgb +
		imageLoad(bounce_light_point_diffuse, atlas_pix).rgb;
	const vec3 specular_light =
		imageLoad(bounce_light_poly_specular, atlas_pix).rgb +
		imageLoad(bounce_light_point_specular, atlas_pix).rgb;
	const vec3 hit_color = mixFinalColor(material.base_color, diffuse_light, specular_light, material.metalness);
	const vec3 contribution = path_throughput * hit_color;

	indirect_diffuse += contribution;
}

void main()
{
	const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
	const ivec2 lane_size = bounceRisLaneSize();
	if (any(greaterThanEqual(pix, lane_size))) {
		return;
	}

	vec3 indirect_diffuse = vec3(0.0);
	vec3 path_throughput = vec3(1.0);

	if ((ubo.ubo.renderer_flags & RENDERER_FLAG_DISABLE_GI) == 0) {
		for (uint lane = 0u; lane < BOUNCE_RIS_DIFFUSE_LANE_COUNT; ++lane) {
			accumulateBounceLane(bounceRisAtlasPixel(pix, lane), path_throughput, indirect_diffuse);
		}
	}

	DEBUG_VALIDATE_RANGE_VEC3("bounce_ris_resolve.diffuse", indirect_diffuse, 0.0, 1e6);

	imageStore(out_indirect_diffuse, pix, vec4(indirect_diffuse, 0.0));
}
