#version 460
layout(local_size_x=8, local_size_y=8) in;
#include "restir_common.glsl"

layout(binding=1, rgba16f) uniform image2D currDiffuse;
layout(binding=2, rgba16f) uniform image2D currSpecular;
layout(binding=3, rgba16f) uniform image2D historyDiffuse;
layout(binding=4, rgba16f) uniform image2D historySpecular;
layout(binding=5, r16f)    uniform image2D confDiffuse;
layout(binding=6, r16f)    uniform image2D confSpecular;

layout(binding=7, rgba16f) uniform image2D outDiffuse;
layout(binding=8, rgba16f) uniform image2D outSpecular;
layout(binding=9, r16f)    uniform image2D outVarDiffuse;
layout(binding=10,r16f)    uniform image2D outVarSpecular;

void processLobeTemporal(in vec3 curr, in vec3 hist, float conf, out vec3 outColor, out float outVar){
    outColor = mix(curr, hist, conf);
    vec3 dx = curr - hist; vec3 dy = curr - hist;
    outVar = dot(dx,dx) + dot(dy,dy);
}

void main(){
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);

    vec3 cD = imageLoad(currDiffuse, px).rgb;
    vec3 hD = imageLoad(historyDiffuse, px).rgb;
    float confD = imageLoad(confDiffuse, px).r;
    vec3 outD; float varD;
    processLobeTemporal(cD,hD,confD,outD,varD);
    imageStore(outDiffuse, px, vec4(outD,1));
    imageStore(outVarDiffuse, px, vec4(varD,0,0,0));

    vec3 cS = imageLoad(currSpecular, px).rgb;
    vec3 hS = imageLoad(historySpecular, px).rgb;
    float confS = imageLoad(confSpecular, px).r;
    vec3 outS; float varS;
    processLobeTemporal(cS,hS,confS,outS,varS);
    imageStore(outSpecular, px, vec4(outS,1));
    imageStore(outVarSpecular, px, vec4(varS,0,0,0));
}
