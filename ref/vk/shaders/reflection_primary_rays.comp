layout(set = 0, binding = 10, rgba32f) uniform readonly image2D position_t;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D normals_gs;
layout(set = 0, binding = 12, rgba8) uniform readonly image2D material_rmxx;
layout(set = 0, binding = 13, rgba8) uniform readonly image2D base_color_a;
layout(set = 0, binding = 14, rgba32f) uniform readonly image2D geometry_prev_position;
layout(set = 0, binding = 15, rgba32f) uniform readonly image2D reflection_path_reprojection;
layout(set = 0, binding = 16, rgba16f) uniform readonly image2D reflection_path_history_ready;
layout(set = 0, binding = 17, rgba32f) uniform readonly image2D prev_reflection_hit_pos;

// Selected random pair, primary roughness, and frame stamp. The reservoir stores
// target, weight sum, effective candidate count, and normalized output weight.
layout(set = 0, binding = 40, rgba32f) uniform readonly image2D prev_temporal_reflection_path_random;
layout(set = 0, binding = 41, rgba32f) uniform readonly image2D prev_temporal_reflection_path_reservoir;
layout(set = 0, binding = 43, rgba32f) uniform writeonly image2D out_temporal_reflection_path_random;
layout(set = 0, binding = 44, rgba32f) uniform writeonly image2D out_temporal_reflection_path_reservoir;
layout(set = 0, binding = 45, rgba16f) uniform writeonly image2D out_temporal_reflection_path_normals;

layout(set = 0, binding = 20, rgba16f) uniform writeonly image2D out_reflection_throughput;
layout(set = 0, binding = 21, rgba32f) uniform writeonly image2D out_reflection_hit_pos;
layout(set = 0, binding = 22, rgba16f) uniform writeonly image2D out_reflection_normals_gs;
layout(set = 0, binding = 23, rgba8) uniform writeonly image2D out_reflection_material_rmxx;
layout(set = 0, binding = 24, rgba8) uniform writeonly image2D out_reflection_base_color_a;
layout(set = 0, binding = 25, rgba16f) uniform writeonly image2D out_reflection_view_dir;
layout(set = 0, binding = 26, rgba16f) uniform writeonly image2D out_reflection_emissive;
layout(set = 0, binding = 27, rgba32f) uniform writeonly image2D out_reflection_direction_pdf;
layout(set = 0, binding = 28, rgba32f) uniform writeonly image2D out_reflection_ray_origin_length;

layout(set = 0, binding = 89, rgba32f) uniform writeonly image2D out_reflection_lightmap_uv;

layout(set = 0, binding = 30, std430) readonly buffer ModelHeaders { ModelHeader a[]; } model_headers;
layout(set = 0, binding = 31, std430) readonly buffer Kusochki { Kusok a[]; } kusochki;
layout(set = 0, binding = 32, std430) readonly buffer Indices { uint16_t a[]; } indices;
layout(set = 0, binding = 33, std430) readonly buffer Vertices { Vertex a[]; } vertices;

