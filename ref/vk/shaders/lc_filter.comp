#version 460
#extension GL_GOOGLE_include_directive : require
#define GLSL
#include "ray_interop.h"
#undef GLSL
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=2) uniform UBO { UniformBuffer ubo; } ubo;
layout(set=0,binding=10,rgba16f) uniform readonly image2D lc_point;
layout(set=0,binding=11,rgba16f) uniform readonly image2D lc_polygon;
layout(set=0,binding=12,rgba16f) uniform readonly image2D prev_temporal_lc_radiance;
layout(set=0,binding=13,rgba32f) uniform readonly image2D prev_temporal_lc_state;
layout(set=0,binding=20,rgba16f) uniform writeonly image2D out_temporal_lc_radiance;
layout(set=0,binding=21,rgba32f) uniform writeonly image2D out_temporal_lc_state;
#include "lightcache_geometry.glsl"
void main() {
    ivec2 pix=ivec2(gl_GlobalInvocationID.xy), res=ubo.ubo.res;
    if (any(greaterThanEqual(pix,res))) return;
    uint index=uint(pix.y*res.x+pix.x);
    vec3 value=vec3(0); float count=0.0;
    float epoch=float(lightcache_geometry.info.y);
    if ((ubo.ubo.renderer_flags & RENDERER_FLAG_LIGHTCACHE_BRUTEFORCE)!=0u) epoch=-epoch-1.0;
    vec4 state=imageLoad(prev_temporal_lc_state,pix);
    bool valid=state.x==epoch &&
        all(equal(state.yz,vec2(res))) && state.w+1.0==float(ubo.ubo.frame_counter);
    if (lightcacheInCapacity(index,res)) {
        if (!lightcacheUpdateDisabled()) {
            // Box filter in island coordinates. Missing edge taps have no weight.
            for (int y=-1;y<=1;++y) for (int x=-1;x<=1;++x) {
                uint neighbor;
                if (!lightcacheNeighbor(index,ivec2(x,y),neighbor) || !lightcacheInCapacity(neighbor,res)) continue;
                ivec2 tap=lightcachePixel(neighbor,res);
                value+=imageLoad(lc_point,tap).rgb+imageLoad(lc_polygon,tap).rgb;
                count+=1.0;
            }
            value/=max(count,1.0);
            if (valid) value=mix(imageLoad(prev_temporal_lc_radiance,pix).rgb,value,0.1);
        } else if (valid) value=imageLoad(prev_temporal_lc_radiance,pix).rgb;
    }
    imageStore(out_temporal_lc_radiance,pix,vec4(clamp(value,vec3(0),vec3(65504)),0));
    imageStore(out_temporal_lc_state,pix,vec4(epoch,vec2(res),float(ubo.ubo.frame_counter)));
}
