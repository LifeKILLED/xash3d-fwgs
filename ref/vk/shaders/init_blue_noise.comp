void main() {
	const ivec2 res = ivec2(vec2(ubo.ubo.res) * ubo.ubo.resScale);
	const ivec2 pix = ivec2(gl_GlobalInvocationID);

	if (any(greaterThanEqual(pix, ivec2(WIDTH, HEIGHT)))) {
		return;
	}

	rand01_state = ubo.ubo.random_seed + pix.x * 1833 + pix.y * 31337 + 12;

	//vec4 bn = vec4(rand01(), rand01(), rand01(), rand01()); // test texture by white noise (crap)
	//vec4 bn = blueNoise(ivec3(pix.xy, ubo.ubo.random_seed)); // broken (renderer problem)

	// TODO: remove this trash after fixing precomputed blue noise textures
	ivec2 id = pix + ivec2(rand01() * WIDTH, rand01() * HEIGHT);
	ivec2 id1 = id % ivec2(WIDTH, HEIGHT);
	ivec2 id2 = (id.yx + ivec2(5, 7)) % ivec2(WIDTH, HEIGHT);
  ivec2 id3 = (-id.yx + ivec2(2, 13)) % ivec2(WIDTH, HEIGHT);
  ivec2 id4 = (-id + ivec2(9, 3)) % ivec2(WIDTH, HEIGHT);
	vec4 bn = vec4(
		float(blue_noise_array1[int(id1.y * WIDTH + id1.x)]),
		float(blue_noise_array1[int(id2.y * WIDTH + id2.x)]),
		float(blue_noise_array1[int(id3.y * WIDTH + id3.x)]),
		float(blue_noise_array1[int(id4.y * WIDTH + id4.x)])
	) / 255.0;

	// add high frequency details
	bn += bn.yzwx / 256.0 + bn.zwxy / (256.0 * 256.0) + bn.wxyz / (256.0 * 256.0 * 256.0);

  for (uint x = pix.x; x < res.x; x += WIDTH) {
    for (uint y = pix.y; y < res.y; y += HEIGHT) {
      	imageStore(out_frame_blue_noise, ivec2(x, y), bn);
    }
  }
}
