#version 460
layout(local_size_x=8, local_size_y=8) in;
#include "restir_common.glsl"

layout(binding=1, rgba16f) uniform image2D gPos;
layout(binding=2, rgba16f) uniform image2D gNorm;
layout(binding=3, rgba16f) uniform image2D gView;

layout(binding=4, rgba32f) uniform image2D resDiffusePrev;
layout(binding=5, rgba32f) uniform image2D resSpecularPrev;
layout(binding=6, rgba32f) uniform image2D resDiffuseCur;
layout(binding=7, rgba32f) uniform image2D resSpecularCur;

layout(binding=8, rgba16f) uniform image2D motionVec;

const ivec2 OFFSETS[4] = ivec2[](ivec2(1,0), ivec2(-1,0),
                                  ivec2(0,1), ivec2(0,-1));

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    uint seed = seedFromPixel(px);

    vec3 P = imageLoad(gPos, px).xyz;
    vec3 N = normalize(imageLoad(gNorm, px).xyz);
    vec4 Vd = imageLoad(gView, px);
    vec3 V = normalize(Vd.xyz);
    float rough = Vd.w;

    // --- Temporal reuse ---
    vec2 mv = imageLoad(motionVec, px).xy;
    ivec2 prevPx = ivec2(vec2(px) + mv);
    Reservoir prevDiffuse = loadReservoir(resDiffusePrev, prevPx);
    Reservoir prevSpec = loadReservoir(resSpecularPrev, prevPx);

    Reservoir rDiffuse = prevDiffuse;
    Reservoir rSpec = prevSpec;

    // --- Spatial reuse (previous frame neighbors) ---
    for(int i=0;i<4;i++){
        ivec2 nPx = px + OFFSETS[i];
        Reservoir nD = loadReservoir(resDiffusePrev, nPx);
        Reservoir nS = loadReservoir(resSpecularPrev, nPx);
        reservoirUpdate(rDiffuse, nD.lightIndex, nD.weightSum, rand(seed));
        reservoirUpdate(rSpec, nS.lightIndex, nS.weightSum, rand(seed));
    }

    // --- New candidates (N=8) ---
    for(int i=0;i<8;i++){
        uint li = (seed + i) % uint(numLights);
        Light L = lights[li];
        vec3 wi = normalize(L.position - P);
        float NdL = max(dot(N, wi),0.0);
        float wDiffuse = NdL * L.intensity;
        float spec = pow(max(dot(reflect(-wi,N),V),0.0), mix(2.0,64.0,1.0-rough));
        float wSpec = spec * L.intensity;

        reservoirUpdate(rDiffuse, li, wDiffuse, rand(seed));
        reservoirUpdate(rSpec, li, wSpec, rand(seed));
    }

    // --- Visibility ---
    if(!visibilityRay(P, lights[rDiffuse.lightIndex].position)) rDiffuse.weightSum*=0.25;
    if(!visibilityRay(P, lights[rSpec.lightIndex].position)) rSpec.weightSum*=0.25;

    imageStore(resDiffuseCur, px, vec4(float(rDiffuse.lightIndex), rDiffuse.weightSum, rDiffuse.W, rDiffuse.M));
    imageStore(resSpecularCur, px, vec4(float(rSpec.lightIndex), rSpec.weightSum, rSpec.W, rSpec.M));
}
