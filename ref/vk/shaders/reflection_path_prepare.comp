#version 460 core
#extension GL_GOOGLE_include_directive : require
#define GLSL
#include "ray_interop.h"
#undef GLSL
#include "debug.glsl"
#include "utils.glsl"
#include "noise.glsl"
#include "reflection_path_config.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 2) uniform UBO { UniformBuffer ubo; } ubo;
layout(set = 0, binding = 10, rgba32f) uniform readonly image2D position_t;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D normals_gs;
layout(set = 0, binding = 12, rgba8) uniform readonly image2D material_rmxx;
layout(set = 0, binding = 13, rgba32f) uniform readonly image2D geometry_prev_position;
layout(set = 0, binding = 14, rgba16f) uniform readonly image2D prev_temporal_asvgf_reproj_depth;
layout(set = 0, binding = 15, rgba32f) uniform readonly image2D prev_temporal_reflection_path_random;
layout(set = 0, binding = 16, rgba32f) uniform readonly image2D prev_temporal_reflection_path_reservoir;
layout(set = 0, binding = 17, rgba16f) uniform readonly image2D prev_temporal_reflection_path_normals;
// .xy = history pixel + 1, .zw = selected random pair. Zero .xy is invalid.
// The fractional part of .x stores an 8-bit owner key / 512 (< 0.5).
// Positive integer conversion still recovers the source coordinate unchanged.
layout(set = 0, binding = 20, rgba32f) uniform writeonly image2D out_reflection_path_reprojection;

#define LOAD_REFLECTION_RAY_LENGTH(pix_) 0.0
#define REPROJECTION_LOAD_PREV_DEPTH_META(pix_) imageLoad(prev_temporal_asvgf_reproj_depth, (pix_))
#include "temporal_reprojection.glsl"

void main()
{
	const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pix, ubo.ubo.res))) return;
	imageStore(out_reflection_path_reprojection, pix, vec4(0.0));
#if REFLECTION_PATH_TEMPORAL_REUSE
	if ((ubo.ubo.renderer_flags & RENDERER_FLAG_DISABLE_REFLECTION) != 0u ||
		imageLoad(position_t, pix).w <= 0.0) return;
	const float restart = uintToFloat01(xxhash32(uvec4(
		uvec2(pix), ubo.ubo.random_seed, 0x72737472u)));
	if (restart < REFLECTION_PATH_RESTART_PROBABILITY) return;
	const vec4 normals = imageLoad(normals_gs, pix);
	ivec2 history_pix;
	float threshold;
	if (!findBestReprojectedHistoryTexelForParams(ubo.ubo.asvgf.indirect_specular,
		imageLoad(geometry_prev_position, pix).xyz, normalDecode(normals.xy),
		pix, ubo.ubo.res, history_pix, threshold)) return;
	const vec4 random_meta = imageLoad(prev_temporal_reflection_path_random, history_pix);
	const vec4 reservoir = imageLoad(prev_temporal_reflection_path_reservoir, history_pix);
	const vec4 old_normals = imageLoad(prev_temporal_reflection_path_normals, history_pix);
	if (IS_INVALIDV(random_meta) || IS_INVALIDV(reservoir) ||
		random_meta.w != float(((ubo.ubo.frame_counter - 1u) & 65535u) + 1u) ||
		any(lessThan(random_meta.xy, vec2(0.0))) || any(greaterThanEqual(random_meta.xy, vec2(1.0))) ||
		abs(random_meta.z - imageLoad(material_rmxx, pix).r) > 0.05 ||
		dot(normalDecode(old_normals.xy), normalDecode(normals.xy)) < 0.95 ||
		reservoir.x <= 0.0 || reservoir.y <= 0.0 || reservoir.z < 1.0) return;
	const uint owner_key = xxhash32(uvec4(uvec2(pix), ubo.ubo.random_seed, 0x726f776eu)) & 255u;
	vec2 encoded_source = vec2(history_pix) + 1.0;
	encoded_source.x += float(owner_key) / 512.0;
	imageStore(out_reflection_path_reprojection, pix, vec4(encoded_source, random_meta.xy));
#endif
}
