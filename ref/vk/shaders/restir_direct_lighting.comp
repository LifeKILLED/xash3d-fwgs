const ivec2 OFFSETS[4] = ivec2[](ivec2(1,0), ivec2(-1,0),
                                  ivec2(0,1), ivec2(0,-1));

vec3 samplingRandom(ivec2 pix, bool previous)
{
#ifdef RANDOM_POISSON_SAMPLING
    uint seed = ANIMATE_PATTERN ? (previous ? ubo.ubo.random_seed : ubo.ubo.random_seed - 1) : 0;
    vec2 poisson_coord = getPoissonCoord(pix + ivec2(int(seed), int(seed>>3)));
    rand01_state = seed + pix.x * 1833 + pix.y * 31337;
    const vec2 poissonNoiseDither = mix(poisson_coord * 0.5 + vec2(0.5), vec2(rand01(),rand01()), POISSON_NOISE_DITHER_SCALE);
    return vec3(poissonNoiseDither, rand01());
#else
    return vec3(rand01(), rand01(), rand01());
#endif
}

vec3 finalShading(
    inout Reservoir r,
    vec3 P,
    vec3 N,
    vec3 V,
    MaterialProperties material,
    SampleContext ctx,
    vec3 rnd,
    bool is_specular,
    float pdf_mult,
    out vec3 sampledL,
    out float lightIdEncoded,
    out float shadowValue,
    out float shadowMaskEnergy
)
{
    sampledL = vec3(0.0);
    lightIdEncoded = 0.0;
    shadowValue = 1.0;
    shadowMaskEnergy = 0.0;

    if (r.w_sum <= 0.0 || r.w_clamped <= 0.0 || r.checked_count <= 0.0)
        return vec3(0.0);

    LightResult l = evalUnifiedLight(P, N, V, material, ctx, r.light_index, rnd, FINAL_RAYS, false);
    sampledL = max(l.sampled_L, vec3(0.0));
    lightIdEncoded = encodeHistoryLightId(l.light_id);

    float pdf_weight = max(pdf_mult, 0.0) * max(restirLightingWeight(r), 0.0);
    vec3 irradiance = max(is_specular ? l.specular : l.diffuse, vec3(0.0));
    shadowValue = l.shadowed ? 0.0 : 1.0;
    float shadow_amount = 1.0 - shadowValue;
    shadowMaskEnergy = max(pdf_weight, 0.0) * shadow_amount;

    return max(irradiance * pdf_weight, vec3(0.0));
}

void main(){
#ifdef RAY_TRACE
	const vec2 uv = (gl_LaunchIDEXT.xy + .5) / gl_LaunchSizeEXT.xy * 2. - 1.;
	const ivec2 pix = ivec2(gl_LaunchIDEXT.xy);
#elif defined(RAY_QUERY)
	const ivec2 pix = ivec2(gl_GlobalInvocationID);
	const ivec2 res = ivec2(vec2(ubo.ubo.res) * ubo.ubo.resScale);
	if (any(greaterThanEqual(pix, res))) {
		return;
	}
	const vec2 uv = (gl_GlobalInvocationID.xy + .5) / res * 2. - 1.;
#else
#error You have two choices here. Ray trace, or Rake Yuri. So what it's gonna be, huh? Choose wisely.
#endif

	// FIXME incorrect for reflection/refraction
	const vec4 target    = ubo.ubo.inv_proj * vec4(uv.x, uv.y, 1, 1);
    const vec3 origin    = (ubo.ubo.inv_view * vec4(0, 0, 0, 1)).xyz;
	const vec3 direction = normalize((ubo.ubo.inv_view * vec4(target.xyz, 0)).xyz);
    const vec3 V = -direction;

	const vec4 material_data = imageLoad(material_rmxx, pix);

	MaterialProperties material;
	material.base_color = SRGBtoLINEAR(imageLoad(base_color_a, pix).rgb);
    material.roughness = material_data.r;
    material.metalness = material_data.g;

    const vec4 packed_normal = imageLoad(normals_gs, pix);
    const vec3 geometry_normal = normalDecode(packed_normal.xy);
    const vec3 shading_normal = normalDecode(packed_normal.zw);
    const vec3 N = shading_normal;

	const vec4 pos_t = imageLoad(position_t, pix);
    const vec3 P = pos_t.xyz + geometry_normal * .001;

    uint total = getLightsCountTotal();
    float pdf_mult = float(total);

#ifndef RANDOM_POISSON_SAMPLING
    rand01_state = ubo.ubo.random_seed + pix.x * 1833 + pix.y * 31337;
#endif

    vec3 sampling_rand_curr = samplingRandom(pix, false);

#ifdef RANDOM_POISSON_SAMPLING
    rand01_state = ubo.ubo.random_seed + pix.x * 1833 + pix.y * 31337;
#endif

    const SampleContext ctx = buildSampleContext(P, N, V);

    vec3 diffuse = vec3(0.);
    float diffuse_conf = 1.0;
    float diffuse_lightid = 0.0;
    float diffuse_shadow = 1.0;
    float diffuse_shadow_energy = 0.0;

    vec3 specular = vec3(0.);
    float specular_conf = 1.0;
    float specular_lightid = 0.0;
    float specular_shadow = 1.0;
    float specular_shadow_energy = 0.0;
    vec3 diffuse_lightdir = vec3(0.0);
    vec3 specular_lightdir = vec3(0.0);

    vec3 diffuse_fs = vec3(0.);
    vec3 specular_fs = vec3(0.);

    bool oub_diff = true, oub_spec = true;
    Reservoir rDiffuse = loadReservoir(imageLoad(diffuse_direct_restir, pix), oub_diff);
    Reservoir rSpecular = loadReservoir(imageLoad(specular_direct_restir, pix), oub_spec);

    if (!oub_diff) {
        diffuse = finalShading(
            rDiffuse, P, N, V, material, ctx, sampling_rand_curr,
            false, pdf_mult, diffuse_lightdir, diffuse_lightid, diffuse_shadow, diffuse_shadow_energy
        );
        if (rDiffuse.checked_count > 0.0 && rDiffuse.w_sum > 0.0 && rDiffuse.w_full > 0.0) {
            diffuse_conf = rDiffuse.conf;
        } else {
            diffuse_conf = 1.0;
        }
    }

    if (!oub_spec) {
        specular = finalShading(
            rSpecular, P, N, V, material, ctx, sampling_rand_curr,
            true, pdf_mult, specular_lightdir, specular_lightid, specular_shadow, specular_shadow_energy
        );
        if (rSpecular.checked_count > 0.0 && rSpecular.w_sum > 0.0 && rSpecular.w_full > 0.0) {
            specular_conf = rSpecular.conf;
        } else {
            specular_conf = 1.0;
        }
    }

    if (luminance(diffuse) <= 1e-6 && diffuse_shadow_energy <= 1e-6) {
        diffuse_conf = 1.0;
    }
    if (luminance(specular) <= 1e-6 && specular_shadow_energy <= 1e-6) {
        specular_conf = 1.0;
    }

    {
        LightResult l = sampleFlashlightAndSky(P, N, V, material, sampling_rand_curr, origin, FINAL_RAYS, false);
        diffuse_fs += max(l.diffuse, vec3(0.0));
        specular_fs += max(l.specular, vec3(0.0));
    }

    //imageStore(out_diffuse_direct, pix, vec4(vec3(diffuse_conf, 0.0, 1.0 - diffuse_conf), diffuse_conf)); // debug diffuse confidence
    //imageStore(out_specular_direct, pix, vec4(vec3(specular_conf, 0.0, 1.0 - specular_conf), specular_conf)); // debug specular confidence
    //imageStore(out_diffuse_direct, pix, vec4(vec3(0.0), diffuse_conf));
    //imageStore(out_specular_direct, pix, vec4(vec3(0.0), specular_conf));

    imageStore(out_diffuse_direct, pix, vec4(diffuse, diffuse_conf));
    imageStore(out_specular_direct, pix, vec4(specular, specular_conf));
    imageStore(out_diffuse_direct_lightdir, pix, vec4(diffuse_lightdir, diffuse_lightid));
    imageStore(out_specular_direct_lightdir, pix, vec4(specular_lightdir, specular_lightid));
    imageStore(out_restir_diffuse_shadows_raw, pix, vec4(diffuse_shadow, diffuse_shadow_energy, 0.0, 1.0));
    imageStore(out_restir_specular_shadows_raw, pix, vec4(specular_shadow, specular_shadow_energy, 0.0, 1.0));

    if (((pix.x & 1) == 0) && ((pix.y & 1) == 0)) {
        const ivec2 packed_res = (res + ivec2(1)) / 2;
        const ivec2 packed_pix = pix / 2;
        if (all(lessThan(packed_pix, packed_res))) {
            const ivec2 p00 = pix;
            const ivec2 p10 = ivec2(min(pix.x + 1, res.x - 1), pix.y);
            const ivec2 p01 = ivec2(pix.x, min(pix.y + 1, res.y - 1));
            const ivec2 p11 = ivec2(min(pix.x + 1, res.x - 1), min(pix.y + 1, res.y - 1));

            bool oob_d00 = true, oob_d10 = true, oob_d01 = true, oob_d11 = true;
            bool oob_s00 = true, oob_s10 = true, oob_s01 = true, oob_s11 = true;

            Reservoir rd00 = loadReservoir(imageLoad(diffuse_direct_restir, p00), oob_d00);
            Reservoir rd10 = loadReservoir(imageLoad(diffuse_direct_restir, p10), oob_d10);
            Reservoir rd01 = loadReservoir(imageLoad(diffuse_direct_restir, p01), oob_d01);
            Reservoir rd11 = loadReservoir(imageLoad(diffuse_direct_restir, p11), oob_d11);

            Reservoir rs00 = loadReservoir(imageLoad(specular_direct_restir, p00), oob_s00);
            Reservoir rs10 = loadReservoir(imageLoad(specular_direct_restir, p10), oob_s10);
            Reservoir rs01 = loadReservoir(imageLoad(specular_direct_restir, p01), oob_s01);
            Reservoir rs11 = loadReservoir(imageLoad(specular_direct_restir, p11), oob_s11);

            float d00 = (!oob_d00 && rd00.w_sum > 0.0 && rd00.w_clamped > 0.0) ? encodeHistoryLightId(rd00.light_index) : 0.0;
            float d10 = (!oob_d10 && rd10.w_sum > 0.0 && rd10.w_clamped > 0.0) ? encodeHistoryLightId(rd10.light_index) : 0.0;
            float d01 = (!oob_d01 && rd01.w_sum > 0.0 && rd01.w_clamped > 0.0) ? encodeHistoryLightId(rd01.light_index) : 0.0;
            float d11 = (!oob_d11 && rd11.w_sum > 0.0 && rd11.w_clamped > 0.0) ? encodeHistoryLightId(rd11.light_index) : 0.0;

            float s00 = (!oob_s00 && rs00.w_sum > 0.0 && rs00.w_clamped > 0.0) ? encodeHistoryLightId(rs00.light_index) : 0.0;
            float s10 = (!oob_s10 && rs10.w_sum > 0.0 && rs10.w_clamped > 0.0) ? encodeHistoryLightId(rs10.light_index) : 0.0;
            float s01 = (!oob_s01 && rs01.w_sum > 0.0 && rs01.w_clamped > 0.0) ? encodeHistoryLightId(rs01.light_index) : 0.0;
            float s11 = (!oob_s11 && rs11.w_sum > 0.0 && rs11.w_clamped > 0.0) ? encodeHistoryLightId(rs11.light_index) : 0.0;

            imageStore(out_diffuse_lightid_packed2x2, packed_pix, vec4(d00, d10, d01, d11));
            imageStore(out_specular_lightid_packed2x2, packed_pix, vec4(s00, s10, s01, s11));
        }
    }

    imageStore(out_diffuse_direct_fs, pix, vec4(diffuse_fs, 0.0));
    imageStore(out_specular_direct_fs, pix, vec4(specular_fs, 0.0));
}

