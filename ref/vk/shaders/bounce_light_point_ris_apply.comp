#version 460 core
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_ray_query: require
#extension GL_EXT_control_flow_attributes : require

#define GLSL
#include "ray_interop.h"
#undef GLSL

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 2) uniform UBO { UniformBuffer ubo; } ubo;
layout(set = 0, binding = 6) uniform sampler2D textures[MAX_TEXTURES];

layout(set = 0, binding = 7) readonly buffer SBOLights { LightsMetadata m; } lights;
layout(set = 0, binding = 8, align = 1) readonly buffer UBOLightClusters {
	LightCluster clusters_[MAX_LIGHT_CLUSTERS];
} light_grid;

layout(set = 0, binding = 10, rgba16f) uniform readonly image2D bounce_throughput;
layout(set = 0, binding = 11, rgba32f) uniform readonly image2D bounce_hit_pos;
layout(set = 0, binding = 12, rgba16f) uniform readonly image2D bounce_normals_gs;
layout(set = 0, binding = 13, rgba8) uniform readonly image2D bounce_material_rmxx;
layout(set = 0, binding = 14, rgba8) uniform readonly image2D bounce_base_color_a;
layout(set = 0, binding = 15, rgba16f) uniform readonly image2D bounce_view_dir;
layout(set = 0, binding = 16, rgba16f) uniform readonly image2D bounce_seed_radiance;
layout(set = 0, binding = 17, rgba16f) uniform readonly image2D bounce_ris_point_candidate;
layout(set = 0, binding = 18, rgba16f) uniform readonly image2D bounce_light_poly_diffuse;
layout(set = 0, binding = 19, rgba16f) uniform readonly image2D bounce_light_poly_specular;

layout(set = 0, binding = 20, rgba16f) uniform writeonly image2D out_indirect_diffuse;
layout(set = 0, binding = 21, rgba16f) uniform writeonly image2D out_indirect_specular;

layout(set = 0, binding = 30, std430) readonly buffer ModelHeaders { ModelHeader a[]; } model_headers;
layout(set = 0, binding = 31, std430) readonly buffer Kusochki { Kusok a[]; } kusochki;
layout(set = 0, binding = 32, std430) readonly buffer Indices { uint16_t a[]; } indices;
layout(set = 0, binding = 33, std430) readonly buffer Vertices { Vertex a[]; } vertices;

#define RAY_QUERY
#define RIS_APPLY_PASS 1
#define LIGHT_POINT 1
#define RIS_POINT_CANDIDATE_IMAGE bounce_ris_point_candidate

#include "bounce_ris_common.glsl"
#include "light_ris.glsl"

void accumulateBounceLane(ivec2 atlas_pix, uint lane, inout vec3 indirect_diffuse, inout vec3 indirect_specular)
{
	const vec3 seed_radiance = imageLoad(bounce_seed_radiance, atlas_pix).rgb;
	if (lane == BOUNCE_RIS_SPECULAR_LANE) {
		indirect_specular += seed_radiance;
	} else {
		indirect_diffuse += seed_radiance;
	}

	vec3 P;
	vec3 geometry_N;
	vec3 shading_N;
	vec3 V;
	vec3 throughput;
	vec3 unused_seed;
	MaterialProperties material;
	const bool surface_active = bounceRisLoadSurface(atlas_pix, P, geometry_N, shading_N, V, material, throughput, unused_seed);
	if (!surface_active) {
		return;
	}

	vec3 point_diffuse = vec3(0.0);
	vec3 point_specular = vec3(0.0);
	vec3 flashlight_diffuse = vec3(0.0);
	vec3 flashlight_specular = vec3(0.0);
	computeLightingRISApply(P, shading_N, V, material, atlas_pix, true, point_diffuse, point_specular, flashlight_diffuse, flashlight_specular);

	const vec3 poly_diffuse = imageLoad(bounce_light_poly_diffuse, atlas_pix).rgb;
	const vec3 poly_specular = imageLoad(bounce_light_poly_specular, atlas_pix).rgb;
	const vec3 hit_color = mixFinalColor(
		material.base_color,
		poly_diffuse + point_diffuse + flashlight_diffuse,
		poly_specular + point_specular + flashlight_specular,
		material.metalness);
	const vec3 contribution = throughput * hit_color;

	if (lane == BOUNCE_RIS_SPECULAR_LANE) {
		indirect_specular += contribution;
	} else {
		indirect_diffuse += contribution;
	}
}

void main()
{
	const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
	const ivec2 lane_size = bounceRisLaneSize();
	if (any(greaterThanEqual(pix, lane_size))) {
		return;
	}

	vec3 indirect_diffuse = vec3(0.0);
	vec3 indirect_specular = vec3(0.0);

	if ((ubo.ubo.renderer_flags & RENDERER_FLAG_DISABLE_GI) == 0) {
		for (uint lane = 0u; lane < 4u; ++lane) {
			const ivec2 atlas_pix = bounceRisAtlasPixel(pix, lane);
			rand01_state = ubo.ubo.random_seed
				+ uint(pix.x) * 1833u
				+ uint(pix.y) * 31337u
				+ lane * 7919u
				+ 0x62706169u;
			accumulateBounceLane(atlas_pix, lane, indirect_diffuse, indirect_specular);
		}
	}

	DEBUG_VALIDATE_RANGE_VEC3("bounce_ris.diffuse", indirect_diffuse, 0.0, 1e6);
	DEBUG_VALIDATE_RANGE_VEC3("bounce_ris.specular", indirect_specular, 0.0, 1e6);

	imageStore(out_indirect_diffuse, pix, vec4(indirect_diffuse, 0.0));
	imageStore(out_indirect_specular, pix, vec4(indirect_specular, 0.0));
}
