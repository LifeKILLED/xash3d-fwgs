float reservoir_pdf(in Reservoir r) {
    sanitizeReservoir(r);
    float denom = max(r.checked_count * r.w_clamped, 1e-6);
    return clamp(r.w_sum / denom, 0.0, MAX_RESTIR_PDF_WEIGHT);
}

float reservoir_luma_estimate(in Reservoir r) {
    if (r.w_clamped <= 0.0 || r.checked_count <= 0.0) {
        return 0.0;
    }

    const float pdf = reservoir_pdf(r);
    return max(r.w_full, 0.0) * max(pdf, 0.0);
}

const ivec2 OFFSETS[4] = ivec2[](ivec2(1,0), ivec2(-1,0),
                                 ivec2(0,1), ivec2(0,-1));

const uint BAYER_4X4[16] = uint[](
    0u,  8u,  2u, 10u,
    12u, 4u, 14u,  6u,
    3u, 11u,  1u,  9u,
    15u, 7u, 13u,  5u
);

uint getBayer4x4Value(ivec2 pix)
{
    const uint ix = uint(pix.x & 3);
    const uint iy = uint(pix.y & 3);
    return BAYER_4X4[iy * 4u + ix];
}

vec2 getNoisyReprojectionUv(vec2 reproj_uv, ivec2 res, ivec2 pix)
{
    if (REPROJECTION_EXTRA_RANDOM_TEXELS > 0.0) {
        const uint rx_hash = xxhash32(uvec3(uint(pix.x), uint(pix.y), ubo.ubo.frame_counter ^ 0x68bc21ebu));
        const uint ry_hash = xxhash32(uvec3(uint(pix.x), uint(pix.y), ubo.ubo.frame_counter ^ 0x02e5be93u));
        const vec2 rnd01 = vec2(uintToFloat01(rx_hash), uintToFloat01(ry_hash));
        const vec2 jitter = (rnd01 * 2.0 - 1.0) * REPROJECTION_EXTRA_RANDOM_TEXELS;
        reproj_uv += jitter;
        reproj_uv = clamp(reproj_uv, vec2(0.0), vec2(res) - vec2(1.001));
    }
    return reproj_uv;
}

bool gatherReprojectedNeighbors(vec2 reproj_uv, ivec2 res, out ivec2 taps[4], out float weights[4])
{
    if (any(lessThan(reproj_uv, vec2(0.0))) || any(greaterThanEqual(reproj_uv, vec2(res)))) {
        return false;
    }

    for (int i = 0; i < 4; ++i) {
        weights[i] = 1.0;
    }

    const ivec2 center = ivec2(floor(reproj_uv + vec2(0.5)));
    taps[0] = center + OFFSETS[0];
    taps[1] = center + OFFSETS[1];
    taps[2] = center + OFFSETS[2];
    taps[3] = center + OFFSETS[3];

    return true;
}
bool isValidReprojectionUv(vec2 uv, ivec2 res)
{
    return all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(res)));
}

bool tryLoadReprojectionUv(ivec2 p, ivec2 res, out vec2 uv)
{
    if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, res))) {
        uv = vec2(0.0);
        return false;
    }

    uv = imageLoad(reprojection_uv, p).xy;
    return isValidReprojectionUv(uv, res);
}

bool computeReprojectionDerivatives(ivec2 pix, ivec2 res, vec2 center_prev_uv, out vec2 d_prev_dx, out vec2 d_prev_dy)
{
    vec2 uv_l;
    vec2 uv_r;
    vec2 uv_d;
    vec2 uv_u;

    bool has_l = tryLoadReprojectionUv(pix + ivec2(-1, 0), res, uv_l);
    bool has_r = tryLoadReprojectionUv(pix + ivec2(1, 0), res, uv_r);
    bool has_d = tryLoadReprojectionUv(pix + ivec2(0, -1), res, uv_d);
    bool has_u = tryLoadReprojectionUv(pix + ivec2(0, 1), res, uv_u);

    bool has_dx = false;
    bool has_dy = false;

    if (has_l && has_r) {
        d_prev_dx = (uv_r - uv_l) * 0.5;
        has_dx = true;
    } else if (has_r) {
        d_prev_dx = uv_r - center_prev_uv;
        has_dx = true;
    } else if (has_l) {
        d_prev_dx = center_prev_uv - uv_l;
        has_dx = true;
    } else {
        d_prev_dx = vec2(0.0);
    }

    if (has_d && has_u) {
        d_prev_dy = (uv_u - uv_d) * 0.5;
        has_dy = true;
    } else if (has_u) {
        d_prev_dy = uv_u - center_prev_uv;
        has_dy = true;
    } else if (has_d) {
        d_prev_dy = center_prev_uv - uv_d;
        has_dy = true;
    } else {
        d_prev_dy = vec2(0.0);
    }

    return has_dx && has_dy;
}

float computeReprojectionMagnification(ivec2 pix, ivec2 res, vec2 center_prev_uv)
{
    if (!isValidReprojectionUv(center_prev_uv, res)) {
        return 1.0;
    }

    vec2 d_prev_dx;
    vec2 d_prev_dy;
    if (!computeReprojectionDerivatives(pix, res, center_prev_uv, d_prev_dx, d_prev_dy)) {
        return 1.0;
    }

    float area = abs(d_prev_dx.x * d_prev_dy.y - d_prev_dx.y * d_prev_dy.x);
    float magnification = 1.0 / max(area, REPROJECTION_MAGNIFICATION_EPS);
    return clamp(magnification, 1.0, REPROJECTION_MAGNIFICATION_MAX);
}

vec3 loadPrevShadingNormalOrFallback(ivec2 p, ivec2 res, vec3 fallbackN)
{
    if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, res))) {
        return fallbackN;
    }
    vec4 prev_norm_mat = imageLoad(prev_temporal_res_norm_mat, p);
    return normalDecode(prev_norm_mat.xy);
}

vec3 loadPrevPositionOrFallback(ivec2 p, ivec2 res, vec3 fallbackP)
{
    if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, res))) {
        return fallbackP;
    }
    return imageLoad(prev_temporal_res_position, p).xyz;
}

float loadPrevFrameVisibility(ivec2 p, ivec2 res, bool is_specular)
{
#if REPROJECTION_USE_SHADOW_VISIBILITY
    if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, res))) {
        return 0.0;
    }

    float vis_sum = 0.0;
    float vis_count = 0.0;
    for (int oy = -REPROJECTION_SHADOW_FILTER_RADIUS; oy <= REPROJECTION_SHADOW_FILTER_RADIUS; ++oy) {
        for (int ox = -REPROJECTION_SHADOW_FILTER_RADIUS; ox <= REPROJECTION_SHADOW_FILTER_RADIUS; ++ox) {
            ivec2 q = p + ivec2(ox, oy);
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, res))) {
                continue;
            }

            float shadow_vis = is_specular
                ? imageLoad(restir_specular_shadows_raw, q).x
                : imageLoad(restir_diffuse_shadows_raw, q).x;
            vis_sum += clamp(shadow_vis, 0.0, 1.0);
            vis_count += 1.0;
        }
    }

    if (vis_count <= 0.0) {
        return 0.0;
    }

    return clamp(vis_sum / vis_count, 0.0, 1.0);
#else
    return 1.0;
#endif
}

vec3 samplingRandom(ivec2 pix, bool previous)
{
#ifdef RANDOM_POISSON_SAMPLING
    uint seed = ANIMATE_PATTERN ? (previous ? ubo.ubo.random_seed : ubo.ubo.random_seed - 1) : 0;
    vec2 poisson_coord = getPoissonCoord(pix + ivec2(int(seed), int(seed>>3)));
    rand01_state = seed + pix.x * 1833 + pix.y * 31337;
    const vec2 poissonNoiseDither = mix(poisson_coord * 0.5 + vec2(0.5), vec2(rand01(),rand01()), POISSON_NOISE_DITHER_SCALE);
    return vec3(poissonNoiseDither, rand01());
#else
    return vec3(rand01(), rand01(), rand01());
#endif
}

float restirCandidateSpecularWeight(in LightResult l)
{
    return max(luminance(l.specular), 0.0);
}

LightResult evaluateRestirCandidateLight(
    vec3 P,
    vec3 N,
    vec3 V,
    MaterialProperties material,
    SampleContext ctx,
    uint light_id,
    vec3 rnd,
    bool use_clusters)
{
    return evalUnifiedLightWeight(P, N, V, material, ctx, light_id, use_clusters);
}

Reservoir reprojectReservoir(
    Reservoir r,
    vec3 prev_evalP,
    vec3 prev_evalN,
    vec3 curr_evalP,
    vec3 curr_evalN,
    vec3 V,
    MaterialProperties material,
    SampleContext ctx,
    vec3 rnd,
    vec3 origin,
    bool is_specular,
    out float conf)
{
    if (isFlashlightOrSky(r.light_index, origin, prev_evalP, false)) {
        conf = CONFIDENCE_REJECTED;
        return reservoirInit(CONFIDENCE_REJECTED);
    }

    LightResult l_prev = evaluateRestirCandidateLight(prev_evalP, prev_evalN, V, material, ctx, r.light_index, rnd, false);

    float prev_w = is_specular
        ? restirCandidateSpecularWeight(l_prev)
        : max(luminance(max(l_prev.diffuse, vec3(0.0))), 0.0);
    updateRestirConfidence(r, prev_w);

    float kill_rnd = rand01();

    bool kill_by_confidence = r.conf < kill_rnd * CONFIDENCE_THRESHOLD;
    if (kill_by_confidence) {
        conf = CONFIDENCE_REJECTED;
        return reservoirInit(CONFIDENCE_REJECTED);
    }

    bool kill_by_lifetime = r.checked_count > (RESERVOIR_LIFETIME_MIN + uint(kill_rnd * RESERVOIR_LIFETIME_MAX));
    if (kill_by_lifetime) {
        conf = 1.0;
        return reservoirInit(CONFIDENCE_REJECTED);
    }

    LightResult l_curr = evaluateRestirCandidateLight(curr_evalP, curr_evalN, V, material, ctx, r.light_index, rnd, false);
    float curr_w = is_specular
        ? restirCandidateSpecularWeight(l_curr)
        : max(luminance(max(l_curr.diffuse, vec3(0.0))), 0.0);
    restirRefreshReservoirWeightsNoConfidence(r, curr_w);
    conf = r.conf;

    return r;
}

Reservoir loadPrevTemporalReservoirAt(ivec2 p, bool is_specular, out bool out_of_bound)
{
    if (is_specular) {
        return loadReservoir(imageLoad(prev_temporal_res_specular, p), out_of_bound);
    }
    return loadReservoir(imageLoad(prev_temporal_res_diffuse, p), out_of_bound);
}

uint reprojectionCollisionRank(ivec2 curr_px, ivec2 target_prev_px)
{
    return xxhash32(uvec3(
        uint(curr_px.x) ^ (uint(target_prev_px.x) * 0x9E3779B9u),
        uint(curr_px.y) ^ (uint(target_prev_px.y) * 0x85EBCA6Bu),
        uint(target_prev_px.x) * 0xC2B2AE35u ^ uint(target_prev_px.y)
    ));
}

bool isReprojectionWinner9Tap(ivec2 curr_pix, ivec2 res, ivec2 target_prev_px, out int collision_count)
{
    collision_count = 0;

    bool has_winner = false;
    uint winner_rank = 0xffffffffu;
    ivec2 winner_px = ivec2(0);

    for (int oy = -REPROJECTION_COLLISION_RADIUS; oy <= REPROJECTION_COLLISION_RADIUS; ++oy) {
        for (int ox = -REPROJECTION_COLLISION_RADIUS; ox <= REPROJECTION_COLLISION_RADIUS; ++ox) {
            ivec2 p = curr_pix + ivec2(ox, oy);
            if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, res))) {
                continue;
            }

            vec2 reproj_uv = imageLoad(reprojection_uv, p).xy;
            if (!isValidReprojectionUv(reproj_uv, res)) {
                continue;
            }

            ivec2 mapped_prev_px = ivec2(floor(reproj_uv + vec2(0.5)));
            if (!all(equal(mapped_prev_px, target_prev_px))) {
                continue;
            }

            collision_count++;

            uint rank = reprojectionCollisionRank(p, target_prev_px);
            bool better_rank = rank < winner_rank;
            bool same_rank = rank == winner_rank;
            bool better_tiebreak = same_rank && ((p.y < winner_px.y) || (p.y == winner_px.y && p.x < winner_px.x));

            if (!has_winner || better_rank || better_tiebreak) {
                has_winner = true;
                winner_rank = rank;
                winner_px = p;
            }
        }
    }

    return has_winner && all(equal(curr_pix, winner_px));
}
void reprojectTemporalReservoir(
    bool is_specular,
    ivec2 curr_pix,
    ivec2 center_prev_px,
    ivec2 res,
    ivec2 reproj_taps[4],
    float reproj_weights[4],
    vec3 prev_P_center,
    vec3 prev_N_center,
    vec3 P,
    vec3 N,
    vec3 V,
    MaterialProperties material,
    SampleContext ctx,
    vec3 origin,
    float reprojection_magnification,
    inout Reservoir out_reservoir,
    inout float out_confidence)
{
    bool reprojected = false;
#if REPROJECTION_USE_CENTER_TAP_ONLY
    if (all(greaterThanEqual(center_prev_px, ivec2(0))) && all(lessThan(center_prev_px, res))) {
        bool out_of_bound;
        Reservoir center_reservoir = loadPrevTemporalReservoirAt(center_prev_px, is_specular, out_of_bound);
        ivec2 selected_prev_px_for_dup = center_prev_px;

        if (!out_of_bound) {
            const vec3 sampling_rand_prev = samplingRandom(center_prev_px, true);
            out_reservoir = reprojectReservoir(center_reservoir, prev_P_center, prev_N_center, P, N, V, material, ctx, sampling_rand_prev, origin, is_specular, out_confidence);
            reprojected = true;

            float center_vis = loadPrevFrameVisibility(center_prev_px, res, is_specular);
            bool center_temporal_valid = out_reservoir.checked_count > 0.0 && out_reservoir.w_sum > 0.0;
            bool center_visible = center_vis > REPROJECTION_VISIBILITY_THRESHOLD;
            bool center_reuse_valid = center_temporal_valid && center_visible;
            bool collision_forced_survivor = false;
            float center_score = center_reuse_valid
                ? (center_vis * max(out_confidence, REPROJECTION_MIN_VALID_CONFIDENCE) * max(out_reservoir.w_sum, 1e-6))
                : 0.0;

            int best_neighbor_idx = -1;
            float best_neighbor_score = center_score;
            Reservoir best_neighbor_reservoir = reservoirInit(0.0);

            for (int i = 0; i < 4; ++i) {
                if (reproj_weights[i] <= 0.0) {
                    continue;
                }

                const ivec2 npx = reproj_taps[i];
                float neighbor_vis = loadPrevFrameVisibility(npx, res, is_specular);
                if (neighbor_vis <= REPROJECTION_VISIBILITY_THRESHOLD) {
                    continue;
                }

                bool neighbor_oob;
                Reservoir nr = loadPrevTemporalReservoirAt(npx, is_specular, neighbor_oob);
                if (neighbor_oob || nr.checked_count <= 0.0 || nr.w_sum <= 0.0) {
                    continue;
                }

                float neighbor_score = neighbor_vis * max(nr.conf, REPROJECTION_MIN_VALID_CONFIDENCE) * max(nr.w_sum, 1e-6);
                if (neighbor_score > best_neighbor_score) {
                    best_neighbor_score = neighbor_score;
                    best_neighbor_idx = i;
                    best_neighbor_reservoir = nr;
                }
            }

            if (REPROJECTION_ALLOW_NEIGHBOR_TRANSFER != 0 && best_neighbor_idx >= 0) {
                ivec2 selected_prev_px = reproj_taps[best_neighbor_idx];
                vec3 prev_N_selected = loadPrevShadingNormalOrFallback(selected_prev_px, res, prev_N_center);
                vec3 prev_P_selected = loadPrevPositionOrFallback(selected_prev_px, res, prev_P_center);
                vec3 sampling_rand_prev_neighbor = samplingRandom(selected_prev_px, true);
                float neighbor_conf = out_confidence;
                Reservoir neighbor_reprojected = reprojectReservoir(
                    best_neighbor_reservoir,
                    prev_P_selected,
                    prev_N_selected,
                    P,
                    N,
                    V,
                    material,
                    ctx,
                    sampling_rand_prev_neighbor,
                    origin,
                    is_specular,
                    neighbor_conf);

                if (neighbor_reprojected.checked_count > 0.0 && neighbor_reprojected.w_sum > 0.0) {
                    out_reservoir = neighbor_reprojected;
                    out_confidence = neighbor_conf;
                    center_reuse_valid = true;
                    selected_prev_px_for_dup = selected_prev_px;
                }
            }

            #if REPROJECTION_KILL_SAME_NEIGHBORS || REPROJECTION_ENABLE_MAGNIFICATION_KILL
#if REPROJECTION_KILL_SAME_NEIGHBORS
            if (center_reuse_valid) {
                int collision_count = 0;
                bool is_collision_winner = isReprojectionWinner9Tap(curr_pix, res, center_prev_px, collision_count);
                if (collision_count > 1) {
                    if (!is_collision_winner) {
                        center_reuse_valid = false;
                        out_confidence = CONFIDENCE_REJECTED;
                        out_reservoir = reservoirInit(CONFIDENCE_REJECTED);
                    } else {
                        collision_forced_survivor = true;
                    }
                }
            }
            #endif

            if (center_reuse_valid) {
                float mag_factor = smoothstep(REPROJECTION_MAGNIFICATION_KILL_START, REPROJECTION_MAGNIFICATION_KILL_FULL, reprojection_magnification);
                float survive_probability = mix(1.0, REPROJECTION_MAGNIFICATION_MIN_SURVIVE, mag_factor);

                if (!collision_forced_survivor && rand01() > survive_probability) {
                    center_reuse_valid = false;
                    out_confidence = CONFIDENCE_REJECTED;
                    out_reservoir = reservoirInit(CONFIDENCE_REJECTED);
                } else {
                    float history_scale = collision_forced_survivor
                        ? max(0.5, survive_probability)
                        : (survive_probability * survive_probability);
                    out_reservoir.checked_count = max(1.0, floor(out_reservoir.checked_count * history_scale));
                    out_reservoir.w_sum *= history_scale;
                    out_reservoir.w_sum = max(out_reservoir.w_sum, out_reservoir.w_clamped);
                    out_confidence *= survive_probability;
                    sanitizeReservoir(out_reservoir);
                }
            }

#endif

            if (!center_reuse_valid) {
                out_confidence = CONFIDENCE_REJECTED;
                out_reservoir = reservoirInit(CONFIDENCE_REJECTED);
            }
        }
    }
#else
    Reservoir temporal_pick = reservoirInit(0.0);
    Reservoir temporal_candidates[4];
    bool temporal_candidate_valid[4];
    bool has_neighbor_candidates = false;
    for (int i = 0; i < 4; ++i) {
        temporal_candidate_valid[i] = false;
    }

    for (int i = 0; i < 4; ++i) {
        if (reproj_weights[i] <= 0.0) {
            continue;
        }
        if (any(lessThan(reproj_taps[i], ivec2(0))) || any(greaterThanEqual(reproj_taps[i], res))) {
            continue;
        }

        bool out_of_bound;
        Reservoir prev_reservoir = loadPrevTemporalReservoirAt(reproj_taps[i], is_specular, out_of_bound);
        if (out_of_bound) {
            continue;
        }

        temporal_candidates[i] = prev_reservoir;
        temporal_candidate_valid[i] = true;
        has_neighbor_candidates = true;

        const float candidate_weight = max(prev_reservoir.w_sum, 0.0);
        reservoirUpdate(temporal_pick, uint(i), candidate_weight, rand01());
    }

    if (has_neighbor_candidates) {
        const uint selected_candidate_idx = temporal_pick.light_index;
        if (selected_candidate_idx < 4u && temporal_candidate_valid[int(selected_candidate_idx)]) {
            const ivec2 selected_prev_px = reproj_taps[int(selected_candidate_idx)];
            const vec3 sampling_rand_prev = samplingRandom(selected_prev_px, true);
            const vec3 prev_N_selected = loadPrevShadingNormalOrFallback(selected_prev_px, res, prev_N_center);
            const vec3 prev_P_selected = loadPrevPositionOrFallback(selected_prev_px, res, prev_P_center);
            out_reservoir = reprojectReservoir(temporal_candidates[int(selected_candidate_idx)], prev_P_selected, prev_N_selected, P, N, V, material, ctx, sampling_rand_prev, origin, is_specular, out_confidence);
            reprojected = true;
        }
    }

    #if REPROJECTION_ENABLE_CENTER_FALLBACK
    if (!reprojected && all(greaterThanEqual(center_prev_px, ivec2(0))) && all(lessThan(center_prev_px, res))) {
        bool out_of_bound;
        Reservoir center_reservoir = loadPrevTemporalReservoirAt(center_prev_px, is_specular, out_of_bound);
        if (!out_of_bound) {
            const vec3 sampling_rand_prev = samplingRandom(center_prev_px, true);
            out_reservoir = reprojectReservoir(center_reservoir, prev_P_center, prev_N_center, P, N, V, material, ctx, sampling_rand_prev, origin, is_specular, out_confidence);
        }
    }
    #endif
#endif
}

void main(){
#ifdef RAY_TRACE
	const vec2 uv = (gl_LaunchIDEXT.xy + .5) / gl_LaunchSizeEXT.xy * 2. - 1.;
	const ivec2 pix = ivec2(gl_LaunchIDEXT.xy);
#elif defined(RAY_QUERY)
	const ivec2 pix = ivec2(gl_GlobalInvocationID);
	const ivec2 res = ivec2(vec2(ubo.ubo.res) * ubo.ubo.resScale);
	if (any(greaterThanEqual(pix, res))) {
		return;
	}
	const vec2 uv = (gl_GlobalInvocationID.xy + .5) / res * 2. - 1.;
#else
#error You have two choices here. Ray trace, or Rake Yuri. So what it's gonna be, huh? Choose wisely.
#endif

	// FIXME incorrect for reflection/refraction
	const vec4 target    = ubo.ubo.inv_proj * vec4(uv.x, uv.y, 1, 1);
    const vec3 origin    = (ubo.ubo.inv_view * vec4(0, 0, 0, 1)).xyz;
	const vec3 direction = normalize((ubo.ubo.inv_view * vec4(target.xyz, 0)).xyz);
    const vec3 V = -direction;

	const vec4 material_data = imageLoad(material_rmxx, pix);

	MaterialProperties material;
	material.base_color = SRGBtoLINEAR(imageLoad(base_color_a, pix).rgb);
    material.roughness = mix(MIN_CANDIDATE_ROUGHNESS, 1.0, material_data.r); // hack for larger specular area
    material.metalness = material_data.g;

    const vec4 packed_normal = imageLoad(normals_gs, pix);
    const vec3 geometry_normal = normalDecode(packed_normal.xy);
    const vec3 shading_normal = normalDecode(packed_normal.zw);
    const vec3 N = shading_normal;

	const vec4 pos_t = imageLoad(position_t, pix);
    const vec3 P = pos_t.xyz + geometry_normal * .001;

    uint total = getLightsCountTotal();
    float pdf_mult = float(total);

    if (CANDIDATES_CLUSTERS) {
        const uint cluster_index = getLightClusterIndex(P);
        const uint total_in_cluster = getLightsCountInCluster(cluster_index);

        pdf_mult = float(total_in_cluster);

        total = total_in_cluster;
    }

#ifndef RANDOM_POISSON_SAMPLING
    rand01_state = ubo.ubo.random_seed + pix.x * 1833 + pix.y * 31337;
#endif

    vec3 sampling_rand_curr = samplingRandom(pix, false);

#ifdef RANDOM_POISSON_SAMPLING
    rand01_state = ubo.ubo.random_seed + pix.x * 1833 + pix.y * 31337;
#endif

    float confDiffuse = 0.;
    float confSpecular = 0.;

    const SampleContext ctx = buildSampleContext(P, N, V);

    Reservoir rDiffuse = reservoirInit(CONFIDENCE_BASELINE);
    Reservoir rSpec = reservoirInit(CONFIDENCE_BASELINE);
    const vec2 prevPxUv = imageLoad(reprojection_uv, pix).xy;
    const bool has_valid_reprojection_uv = all(greaterThanEqual(prevPxUv, vec2(0.0))) && all(lessThan(prevPxUv, vec2(res)));
    const vec2 prevPxUvNoisy = has_valid_reprojection_uv ? getNoisyReprojectionUv(prevPxUv, res, pix) : prevPxUv;
    const float reprojection_magnification = computeReprojectionMagnification(pix, res, prevPxUvNoisy);
    const ivec2 center_prev_px = ivec2(floor(prevPxUvNoisy + vec2(0.5)));

    ivec2 reproj_taps[4];
    float reproj_weights[4];
    const bool has_reprojected_neighbors = has_valid_reprojection_uv && gatherReprojectedNeighbors(prevPxUvNoisy, res, reproj_taps, reproj_weights);
    const vec3 prev_N_center = loadPrevShadingNormalOrFallback(center_prev_px, res, N);
    const vec3 prev_P_center = loadPrevPositionOrFallback(center_prev_px, res, P);
    float prev_vis_diffuse = 1.0;
    float prev_vis_specular = 1.0;
    bool prev_full_shadow_diffuse = false;
    bool prev_full_shadow_specular = false;
    if (has_valid_reprojection_uv) {
        prev_vis_diffuse = loadPrevFrameVisibility(center_prev_px, res, false);
        prev_vis_specular = loadPrevFrameVisibility(center_prev_px, res, true);
        prev_full_shadow_diffuse = prev_vis_diffuse <= REPROJECTION_FULL_SHADOW_THRESHOLD;
        prev_full_shadow_specular = prev_vis_specular <= REPROJECTION_FULL_SHADOW_THRESHOLD;
    }

    if (!has_valid_reprojection_uv) {
        // Break temporal chain when temporal reprojection has no valid previous pixel.
        rDiffuse = reservoirInit(CONFIDENCE_REJECTED);
        rSpec = reservoirInit(CONFIDENCE_REJECTED);
    }

    if (has_reprojected_neighbors && total > 0) { // avoid reprojection if have no visible lights
        if (!prev_full_shadow_diffuse) {
            reprojectTemporalReservoir(false, pix, center_prev_px, res, reproj_taps, reproj_weights, prev_P_center, prev_N_center, P, N, V, material, ctx, origin, reprojection_magnification, rDiffuse, confDiffuse);
        } else {
            rDiffuse = reservoirInit(CONFIDENCE_REJECTED);
            confDiffuse = CONFIDENCE_REJECTED;
        }
        if (!prev_full_shadow_specular) {
            reprojectTemporalReservoir(true, pix, center_prev_px, res, reproj_taps, reproj_weights, prev_P_center, prev_N_center, P, N, V, material, ctx, origin, reprojection_magnification, rSpec, confSpecular);
        } else {
            rSpec = reservoirInit(CONFIDENCE_REJECTED);
            confSpecular = CONFIDENCE_REJECTED;
        }
    }
    if(total > 0) {
        const bool reprojection_out_of_bounds = !has_valid_reprojection_uv;
        const bool use_fast_candidate_limit = !reprojection_out_of_bounds;
        const uint candidates_count = use_fast_candidate_limit ? CANDIDATES_COUNT_FAST : CANDIDATES_COUNT_FULL;
        const bool iterate_all = total <= candidates_count;

        uint first_light_id = 0u;
#if CANDIDATE_ID_SAMPLING_MODE == STABLE_START_CANDIDATES
        const uint bayer_value = getBayer4x4Value(pix);
        const float frame_counter_f = float(ubo.ubo.frame_counter);
        const float candidates_per_frame_f = float(candidates_count);
        const float total_f = float(total);

        const float bayer_dither_norm = total > 1u ? (float(bayer_value) / 15.0) : 0.0;
        const float bayer_offset_f = bayer_dither_norm * (total_f - 1.0);
        const float candidate_index_start_f = frame_counter_f * candidates_per_frame_f + bayer_offset_f;
        first_light_id = uint(candidate_index_start_f) % total;
#elif CANDIDATE_ID_SAMPLING_MODE == RANDOM_START_CANDIDATES
        first_light_id = uint(rand01() * float(total));
#endif

        LightRandomPickData diff_pick = LightRandomPickData(0,0,0,0,0,-1);
        LightRandomPickData spec_pick = LightRandomPickData(0,0,0,0,0,-1);

        for (uint i = 0; i < CANDIDATES_COUNT_FULL; i++) { // fixed-width loop for lower divergence
            if (use_fast_candidate_limit && i >= CANDIDATES_COUNT_FAST) {
                break;
            }

            const bool out_of_bounds = (CANDIDATE_ID_SAMPLING_MODE != FULL_RANDOM_CANDIDATES) && iterate_all && i >= total;
            if (!out_of_bounds) {
                uint light_id = 0u;
#if CANDIDATE_ID_SAMPLING_MODE == FULL_RANDOM_CANDIDATES
                light_id = uint(rand01() * float(total));
#else
                light_id = iterate_all ? i : (first_light_id + i) % total;
#endif

                if (!isFlashlightOrSky(light_id, origin, P, CANDIDATES_CLUSTERS)) {
                    if (prev_full_shadow_diffuse && prev_full_shadow_specular) {
                        continue;
                    }
                    const LightResult l = evaluateRestirCandidateLight(P, N, V, material, ctx, light_id, sampling_rand_curr, CANDIDATES_CLUSTERS);

                    const float wDiffuse = max(luminance(max(l.diffuse, vec3(0.0))), 0.0);
                    const float wSpec = restirCandidateSpecularWeight(l);

                    if (!prev_full_shadow_diffuse) { reservoirUpdate(rDiffuse, l.light_id, wDiffuse, rand01()); }
                    if (!prev_full_shadow_specular) { reservoirUpdate(rSpec, l.light_id, wSpec, rand01()); }
                }
            }
        }
    }
    // Empty reservoirs represent absence of valid light samples, not instability.
    if (rDiffuse.checked_count <= 0.0 || rDiffuse.w_sum <= 0.0 || rDiffuse.w_full <= 0.0) {
        rDiffuse.conf = 1.0;
    }
    if (rSpec.checked_count <= 0.0 || rSpec.w_sum <= 0.0 || rSpec.w_full <= 0.0) {
        rSpec.conf = 1.0;
    }

    vec3 diffuse = vec3(0.);
    vec3 specular = vec3(0.);

    imageStore(out_diffuse_direct_restir, pix, saveReservoir(rDiffuse));
    imageStore(out_specular_direct_restir, pix, saveReservoir(rSpec));
    imageStore(out_restir_stabilize_metric_raw, pix, vec4(
        reservoir_luma_estimate(rDiffuse),
        reservoir_luma_estimate(rSpec),
        0.0, 0.0
    ));

    imageStore(out_temporal_res_diffuse, pix, saveReservoir(rDiffuse));
    imageStore(out_temporal_res_specular, pix, saveReservoir(rSpec));
    imageStore(out_temporal_res_norm_mat, pix, vec4(normalEncode(shading_normal), material.roughness, material.metalness));
    imageStore(out_temporal_res_position, pix, vec4(P, 1.0));
}
