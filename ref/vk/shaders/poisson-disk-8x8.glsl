vec3 randomizePointLightDir(vec2 rnd, vec3 dir, float radius)
{
    const vec3 dir_norm = normalize(dir);

    const vec3 stable_axis = abs(dir.z) > abs(dir.x) && abs(dir.z) > abs(dir.y) ?
        vec3(1.0, 0.0, 0.0) :
        vec3(0.0, 0.0, 1.0);

    // save radius for all angles but have many multiplies
    const vec3 x_axis = cross(dir_norm, stable_axis);
    const vec3 y_axis = cross(dir_norm, x_axis);

    return dir + rnd.x * x_axis + rnd.y * y_axis;
}

vec3 randomizePolyLightDirSimple(vec2 rnd, vec3 dir, vec3 plane_norm, vec3 tangent, float binormal_length)
{
    const vec3 binormal = cross(plane_norm, normalize(tangent)) * binormal_length;
    return dir + rnd.x * tangent + rnd.y * binormal;
}
