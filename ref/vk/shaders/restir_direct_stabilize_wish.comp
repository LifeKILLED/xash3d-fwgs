#version 460 core
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_ray_query: require
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_control_flow_attributes2 : require

#define MIN_CANDIDATE_ROUGHNESS 0.01
#define STUPID_POLYGON_SAMPLING 1
#define STUPID_POINT_LIGHT_SAMPLING 1
#define LIMIT_LIGHT_LUMINANCE 1
#define DISABLE_RAYS 1

#define GLSL
#include "ray_interop.h"
#undef GLSL

#include "noise.glsl"
#include "denoiser_config.glsl"
#include "utils.glsl"
#include "brdf.glsl"
#include "color_spaces.glsl"

#define LIGHT_POINT 1
#define LIGHT_POLYGON 1
#define RAY_QUERY

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D restir_stabilize_metric_raw_diffuse;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D restir_stabilize_metric_raw_specular;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D diffuse_direct_current_atrous;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D specular_direct_current_atrous;
layout(set = 0, binding = 4, rgba32f) uniform writeonly image2D out_restir_stabilize_wish;
layout(set = 0, binding = 5) uniform UBO { UniformBuffer ubo; } ubo;
layout(set = 0, binding = 6, rgba32f) uniform readonly image2D position_t;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D normals_gs;
layout(set = 0, binding = 8, rgba32f) uniform readonly image2D diffuse_direct_restir;
layout(set = 0, binding = 9, rgba32f) uniform readonly image2D specular_direct_restir;
layout(set = 0, binding = 10, rgba8) uniform readonly image2D material_rmxx;
layout(set = 0, binding = 11, rgba8) uniform readonly image2D base_color_a;
layout(set = 0, binding = 12) uniform sampler2D textures[MAX_TEXTURES];
layout(set = 0, binding = 13) uniform accelerationStructureEXT tlas;
layout (set = 0, binding = 14) readonly buffer SBOLights { LightsMetadata m; } lights;
layout (set = 0, binding = 15, align = 1) readonly buffer UBOLightClusters {
    LightCluster clusters_[MAX_LIGHT_CLUSTERS];
} light_grid;
layout(set = 0, binding = 30, std430) readonly buffer ModelHeaders { ModelHeader a[]; } model_headers;
layout(set = 0, binding = 31, std430) readonly buffer Kusochki { Kusok a[]; } kusochki;
layout(set = 0, binding = 32, std430) readonly buffer Indices { uint16_t a[]; } indices;
layout(set = 0, binding = 33, std430) readonly buffer Vertices { Vertex a[]; } vertices;

#define WISH_DEAD_ZONE 0.001

#define NEIGHBOR_COUNT 8
const ivec2 neighbor_offsets[8] = ivec2[](
    ivec2( 1,  0), ivec2(-1,  0),
    ivec2( 0,  1), ivec2( 0, -1),
    ivec2( 1,  1), ivec2(-1,  -1),
    ivec2( -1,  1), ivec2( 1, -1)
);

#include "ray_kusochki.glsl"
#include "restir_common.glsl"
bool in_bounds(ivec2 p, ivec2 res) {
    return all(greaterThanEqual(p, ivec2(0))) && all(lessThan(p, res));
}
float deterministic_tie(ivec2 p, int channel) {
    uint h = uint(p.x) * 73856093u;
    h ^= uint(p.y) * 19349663u;
    h ^= uint(channel) * 83492791u;
    h ^= (h >> 13);
    h *= 1274126177u;
    return float(h & 0x00ffffffu) * (1.0 / 16777216.0);
}

uint wish_permutation_seed(ivec2 p, int channel)
{
    uint h = uint(p.x) * 0x9e3779b9u;
    h ^= uint(p.y) * 0x85ebca6bu;
    h ^= uint(channel) * 0xc2b2ae35u;
#if !DENOISER_STABLE_STABILIZATION
    h ^= uint(ubo.ubo.frame_counter) * 0x27d4eb2du;
#endif
    h ^= (h >> 16);
    h *= 0x7feb352du;
    h ^= (h >> 15);
    h *= 0x846ca68bu;
    h ^= (h >> 16);
    return h;
}

int wish_permutation_stride(uint seed)
{
    const int strides[4] = int[](1, 3, 5, 7);
    return strides[int((seed >> 8u) & 3u)];
}

float wish_neighbor_shape_weight(ivec2 offset)
{
    const bool is_diagonal = (abs(offset.x) + abs(offset.y)) == 2;
    return is_diagonal ? 0.86 : 1.0;
}

float wish_border_weight(ivec2 p, ivec2 res)
{
    const int edge_dist = min(min(p.x, p.y), min(res.x - 1 - p.x, res.y - 1 - p.y));
    return clamp((float(edge_dist) + 1.0) * 0.34, 0.38, 1.0);
}

float load_raw_metric(ivec2 p, bool specular_channel)
{
    return specular_channel
        ? max(imageLoad(restir_stabilize_metric_raw_specular, p).r, 0.0)
        : max(imageLoad(restir_stabilize_metric_raw_diffuse, p).r, 0.0);
}

float load_smoothed_luma(ivec2 p, bool specular_channel)
{
    vec3 c = specular_channel
        ? imageLoad(specular_direct_current_atrous, p).rgb
        : imageLoad(diffuse_direct_current_atrous, p).rgb;
    return max(luminance(max(c, vec3(0.0))), 0.0);
}

vec3 samplingRandom(ivec2 pix)
{
    rand01_state = ubo.ubo.random_seed + pix.x * 1833 + pix.y * 31337;
    return vec3(rand01(), rand01(), rand01());
}

float restirCandidateSpecularWeight(in LightResult l)
{
    return max(luminance(l.specular), 0.0);
}

LightResult evaluateRestirCandidateLight(
    vec3 P,
    vec3 N,
    vec3 V,
    MaterialProperties material,
    SampleContext ctx,
    uint light_id,
    vec3 rnd)
{
    return evalUnifiedLightWeight(P, N, V, material, ctx, light_id, false);
}

Reservoir load_center_reservoir(ivec2 p, bool specular_channel, out bool out_of_bound)
{
    vec4 packed;
    if (specular_channel) {
        packed = imageLoad(specular_direct_restir, p);
    } else {
        packed = imageLoad(diffuse_direct_restir, p);
    }

    return loadReservoir(packed, out_of_bound);
}
float estimate_reservoir_preview_luma(
    ivec2 pix,
    Reservoir r,
    bool specular_channel,
    float fallback_luma)
{
    if (r.checked_count <= 0.0) {
        return fallback_luma;
    }

    const vec4 packed_normal = imageLoad(normals_gs, pix);
    const vec3 geometry_normal = normalDecode(packed_normal.xy);
    const vec3 shading_normal = normalDecode(packed_normal.zw);
    const vec4 pos_t = imageLoad(position_t, pix);

    const ivec2 res = ivec2(vec2(ubo.ubo.res) * ubo.ubo.resScale);
    const vec2 uv = vec2(pix) / vec2(res) * 2.0 - 1.0;
    const vec4 target = ubo.ubo.inv_proj * vec4(uv.x, uv.y, 1.0, 1.0);
    const vec3 direction = normalize((ubo.ubo.inv_view * vec4(target.xyz, 0)).xyz);
    const vec3 V = -direction;

    MaterialProperties material;
    const vec4 material_data = imageLoad(material_rmxx, pix);
    material.base_color = SRGBtoLINEAR(imageLoad(base_color_a, pix).rgb);
    material.roughness = mix(MIN_CANDIDATE_ROUGHNESS, 1.0, material_data.r);
    material.metalness = material_data.g;

    const vec3 P = pos_t.xyz + geometry_normal * .001;
    const vec3 N = shading_normal;
    const SampleContext ctx = buildSampleContext(P, N, V);
    const vec3 sampling_rand = samplingRandom(pix);

    const LightResult l = evaluateRestirCandidateLight(P, N, V, material, ctx, r.light_index, sampling_rand);

    float w = specular_channel
        ? restirCandidateSpecularWeight(l)
        : luminance(l.diffuse);

    if (isnan(w) || isinf(w)) {
        w = fallback_luma;
    }

    return max(w, 0.0);
}

ivec2 select_wish_channel(ivec2 pix, ivec2 res, int metric_channel, bool specular_channel)
{
    const float center_raw = load_raw_metric(pix, specular_channel);
    const float center_blur = load_smoothed_luma(pix, specular_channel);
    const float denom = max(abs(center_blur), 1e-6);
    const float rel_diff = (center_raw - center_blur) / denom;
    if (abs(rel_diff) <= WISH_DEAD_ZONE) {
        return pix;
    }

    bool center_oob = false;
    const Reservoir center_reservoir = load_center_reservoir(pix, specular_channel, center_oob);
    const bool use_preview_guard = rel_diff > 0.0 && !center_oob && center_reservoir.checked_count > 0.0;
    const float center_preview_luma = use_preview_guard
        ? estimate_reservoir_preview_luma(pix, center_reservoir, specular_channel, center_blur)
        : center_blur;

    const vec3 p0 = imageLoad(position_t, pix).xyz;
    const vec3 g0 = normalDecode(imageLoad(normals_gs, pix).xy);
    const float inv_center_dist = 1.0 / max(length(p0), 1.0);
    const vec3 cam_pos = (ubo.ubo.inv_view * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    const float world_texel_size = estimateWorldTexelSizeFromCenter(
        pix, res, cam_pos, p0, ubo.ubo.inv_proj, ubo.ubo.inv_view, DENOISER_POSITION_TEXEL_SIZE_MARGIN);

    ivec2 best_pix = pix;
    float best_score = 0.0;
    float best_tie = 2.0;
    uint perm_seed = wish_permutation_seed(pix, metric_channel);
#if !DENOISER_STABLE_STABILIZATION
    perm_seed ^= uint(ubo.ubo.random_seed) * 0x165667b1u;
    rand01_state = perm_seed ^ (uint(metric_channel) * 0x9e3779b9u);
#endif
    const int start_i = int(perm_seed & uint(NEIGHBOR_COUNT - 1));
    const int stride_i = wish_permutation_stride(perm_seed);

    for (int i = 0; i < NEIGHBOR_COUNT; ++i) {
        const int neighbor_idx = (start_i + i * stride_i) & (NEIGHBOR_COUNT - 1);
        const ivec2 neighbor_offset = neighbor_offsets[neighbor_idx];
        const ivec2 q = pix + neighbor_offset;
        if (!in_bounds(q, res)) {
            continue;
        }

        const vec3 p1 = imageLoad(position_t, q).xyz;
        const float wp = positionEdgeStopWithWorldTexel(
            p1 - p0,
            g0,
            inv_center_dist,
            DENOISER_POSITION_PLANE_THRESHOLD,
            world_texel_size);
        if (wp == 0.0) {
            continue;
        }

        const float bq = load_smoothed_luma(q, specular_channel);
#if DENOISER_STABLE_STABILIZATION
        const float tie = deterministic_tie(q, metric_channel);
#else
        const float tie = rand01();
#endif

        float score = 0.0;
        if (rel_diff > 0.0) {
            const float atrous_delta = center_blur - bq;
            if (atrous_delta <= 1e-6) {
                continue;
            }

            float corrected_delta = atrous_delta;
            if (use_preview_guard) {
                const float q_preview_luma = estimate_reservoir_preview_luma(
                    q, center_reservoir, specular_channel, bq);
                const float preview_delta = center_preview_luma - q_preview_luma;
                corrected_delta -= max(preview_delta, 0.0);
            }

            score = max(corrected_delta, 0.0);
        } else {
            score = max(bq - center_blur, 0.0);
        }

        score *= wish_neighbor_shape_weight(neighbor_offset);
        score *= wish_border_weight(q, res);

        if ((score > best_score + 1e-6) ||
            (abs(score - best_score) <= 1e-6 && score > 1e-6 && tie < best_tie)) {
            best_score = score;
            best_tie = tie;
            best_pix = q;
        }
    }

    if (best_score <= 1e-6) {
        return pix;
    }

    return best_pix;
}

void main() {
    const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 res = ivec2(vec2(ubo.ubo.res) * ubo.ubo.resScale);
    if (any(greaterThanEqual(pix, res))) {
        return;
    }

#if !DENOISER_ENABLE_STABILIZE_RESERVOIRS
    imageStore(
        out_restir_stabilize_wish,
        pix,
        vec4(float(pix.x), float(pix.y), float(pix.x), float(pix.y))
    );
    return;
#endif

    const ivec2 diffuse_wish = select_wish_channel(pix, res, 0, false);
    const ivec2 specular_wish = select_wish_channel(pix, res, 1, true);

    imageStore(
        out_restir_stabilize_wish,
        pix,
        vec4(
            float(diffuse_wish.x), float(diffuse_wish.y),
            float(specular_wish.x), float(specular_wish.y)
        )
    );
}
