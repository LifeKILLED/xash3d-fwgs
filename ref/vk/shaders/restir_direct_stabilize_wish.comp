#version 460 core
#extension GL_GOOGLE_include_directive : require

#define GLSL
#include "ray_interop.h"
#undef GLSL

#include "noise.glsl"
#include "denoiser_config.glsl"
#include "utils.glsl"
#define RESTIR_COMMON_NO_LIGHTING
#include "restir_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D restir_stabilize_metric_raw;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D restir_stabilize_metric;
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D out_restir_stabilize_wish;
layout(set = 0, binding = 3) uniform UBO { UniformBuffer ubo; } ubo;
layout(set = 0, binding = 4, rgba32f) uniform readonly image2D position_t;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D normals_gs;

#define WISH_DEAD_ZONE 0.02

const ivec2 neighbor_offsets[8] = ivec2[](
    ivec2( 1,  0), ivec2(-1,  0),
    ivec2( 0,  1), ivec2( 0, -1),
    ivec2( 1,  1), ivec2(-1,  1),
    ivec2( 1, -1), ivec2(-1, -1)
);

bool in_bounds(ivec2 p, ivec2 res) {
    return all(greaterThanEqual(p, ivec2(0))) && all(lessThan(p, res));
}

ivec2 select_wish_channel(ivec2 pix, ivec2 res, int raw_channel, int blur_channel)
{
    const vec2 center_raw_v = imageLoad(restir_stabilize_metric_raw, pix).rg;
    const vec2 center_blur_v = imageLoad(restir_stabilize_metric, pix).rg;
    const float center_raw = center_raw_v[raw_channel];
    const float center_blur = center_blur_v[blur_channel];
    const vec3 p0 = imageLoad(position_t, pix).xyz;
    const vec3 g0 = normalDecode(imageLoad(normals_gs, pix).xy);
    const float inv_center_dist = 1.0 / max(length(p0), 1.0);
    const vec3 cam_pos = (ubo.ubo.inv_view * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    const float world_texel_size = estimateWorldTexelSizeFromCenter(
        pix, res, cam_pos, p0, ubo.ubo.inv_proj, ubo.ubo.inv_view, DENOISER_POSITION_TEXEL_SIZE_MARGIN);

    ivec2 best_dark = pix;
    ivec2 best_bright = pix;
    float best_dark_blur = center_blur;
    float best_bright_blur = center_blur;
    float best_dark_tie = 2.0;
    float best_bright_tie = 2.0;
    rand01_state =
        uint(ubo.ubo.random_seed) +
        uint(pix.x) * 1833u +
        uint(pix.y) * 31337u +
        uint(blur_channel) * 977u;
    for (int i = 0; i < 8; ++i) {
        const ivec2 q = pix + neighbor_offsets[i];
        if (!in_bounds(q, res)) {
            continue;
        }

        const vec3 p1 = imageLoad(position_t, q).xyz;
        const float wp = positionEdgeStopWithWorldTexel(
            p1 - p0,
            g0,
            inv_center_dist,
            DENOISER_POSITION_PLANE_THRESHOLD,
            world_texel_size);
        if (wp == 0.0) {
            continue;
        }

        const float bq = imageLoad(restir_stabilize_metric, q).rg[blur_channel];
        const float tie = rand01();

        if ((bq < best_dark_blur - 1e-6) ||
            (abs(bq - best_dark_blur) <= 1e-6 && bq < center_blur - 1e-6 && tie < best_dark_tie)) {
            best_dark_blur = bq;
            best_dark_tie = tie;
            best_dark = q;
        }

        if ((bq > best_bright_blur + 1e-6) ||
            (abs(bq - best_bright_blur) <= 1e-6 && bq > center_blur + 1e-6 && tie < best_bright_tie)) {
            best_bright_blur = bq;
            best_bright_tie = tie;
            best_bright = q;
        }
    }

    const float denom = max(abs(center_blur), 1e-6);
    const float rel_diff = (center_raw - center_blur) / denom;
    if (abs(rel_diff) <= WISH_DEAD_ZONE) {
        return pix;
    }

    return (rel_diff > 0.0) ? best_dark : best_bright;
}

void main() {
    const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 res = ivec2(vec2(ubo.ubo.res) * ubo.ubo.resScale);
    if (any(greaterThanEqual(pix, res))) {
        return;
    }

#if !DENOISER_ENABLE_STABILIZE_RESERVOIRS
    imageStore(
        out_restir_stabilize_wish,
        pix,
        vec4(float(pix.x), float(pix.y), float(pix.x), float(pix.y))
    );
    return;
#endif

    const ivec2 diffuse_wish = select_wish_channel(pix, res, 0, 0);
    const ivec2 specular_wish = select_wish_channel(pix, res, 1, 1);

    imageStore(
        out_restir_stabilize_wish,
        pix,
        vec4(
            float(diffuse_wish.x), float(diffuse_wish.y),
            float(specular_wish.x), float(specular_wish.y)
        )
    );
}
