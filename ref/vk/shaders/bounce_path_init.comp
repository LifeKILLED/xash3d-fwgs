layout(set = 0, binding = 2) uniform UBO { UniformBuffer ubo; } ubo;
layout(set = 0, binding = 6) uniform sampler2D textures[MAX_TEXTURES];
layout(set = 0, binding = 7) uniform samplerCube skybox;

layout(set = 0, binding = 10, rgba32f) uniform readonly image2D position_t;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D normals_gs;
layout(set = 0, binding = 12, rgba32f) uniform readonly image2D geometry_prev_position;
layout(set = 0, binding = 13, rgba16f) uniform readonly image2D prev_temporal_asvgf_reproj_depth;

layout(set = 0, binding = 20, rgba16f) uniform writeonly image2D out_bounce_path_fresh_throughput;
layout(set = 0, binding = 21, rgba32f) uniform writeonly image2D out_bounce_path_fresh_hit_pos;
layout(set = 0, binding = 22, rgba16f) uniform writeonly image2D out_bounce_path_fresh_normals_gs;
layout(set = 0, binding = 23, rgba8) uniform writeonly image2D out_bounce_path_fresh_material_rmxx;
layout(set = 0, binding = 24, rgba8) uniform writeonly image2D out_bounce_path_fresh_base_color_a;
layout(set = 0, binding = 25, rgba16f) uniform writeonly image2D out_bounce_path_fresh_view_dir;
layout(set = 0, binding = 26, rgba16f) uniform writeonly image2D out_bounce_path_fresh_emissive;
layout(set = 0, binding = 27, rgba32f) uniform writeonly image2D out_bounce_path_fresh_ray_origin_length;
layout(set = 0, binding = 28, rgba32f) uniform writeonly image2D out_bounce_path_fresh_meta;
layout(set = 0, binding = 29, rgba32f) uniform writeonly image2D out_bounce_path_history_ref;

layout(set = 0, binding = 40, rgba16f) uniform readonly image2D prev_temporal_bounce_path_throughput;
layout(set = 0, binding = 41, rgba32f) uniform readonly image2D prev_temporal_bounce_path_hit_pos;
layout(set = 0, binding = 42, rgba16f) uniform readonly image2D prev_temporal_bounce_path_normals_gs;
layout(set = 0, binding = 43, rgba16f) uniform readonly image2D prev_temporal_bounce_path_view_dir;
layout(set = 0, binding = 44, rgba32f) uniform readonly image2D prev_temporal_bounce_path_ray_origin_length;
layout(set = 0, binding = 45, rgba32f) uniform readonly image2D prev_temporal_bounce_path_meta;
layout(set = 0, binding = 46, rgba32f) uniform readonly image2D temporal_reprojection_bounce_source;

layout(set = 0, binding = 50, std430) readonly buffer ModelHeaders { ModelHeader a[]; } model_headers;
layout(set = 0, binding = 51, std430) readonly buffer Kusochki { Kusok a[]; } kusochki;
