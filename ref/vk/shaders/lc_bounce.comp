layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=1) uniform accelerationStructureEXT tlas;
layout(set=0,binding=2) uniform UBO { UniformBuffer ubo; } ubo;
layout(set=0,binding=6) uniform sampler2D textures[MAX_TEXTURES];
layout(set=0,binding=7) uniform samplerCube skybox;
layout(set=0,binding=10,rgba32f) uniform readonly image2D position_t;
layout(set=0,binding=11,rgba16f) uniform readonly image2D normals_gs;
layout(set=0,binding=14,rgba16f) uniform readonly image2D temporal_lc_radiance;
layout(set=0,binding=20,rgba16f) uniform writeonly image2D out_indirect_diffuse;
layout(set=0,binding=22,rgba32f) uniform writeonly image2D out_first_bounce_direction;
layout(set=0,binding=30,std430) readonly buffer ModelHeaders { ModelHeader a[]; } model_headers;
layout(set=0,binding=31,std430) readonly buffer Kusochki { Kusok a[]; } kusochki;
layout(set=0,binding=32,std430) readonly buffer Indices { uint16_t a[]; } indices;
layout(set=0,binding=33,std430) readonly buffer Vertices { Vertex a[]; } vertices;
layout(set=0,binding=15,rgba32f) uniform readonly image2D temporal_reprojection_bounce_source;
layout(set=0,binding=40,rgba32f) uniform readonly image2D prev_temporal_lc_bounce_path;
layout(set=0,binding=41,rgba32f) uniform readonly image2D prev_temporal_lc_bounce_reservoir;
layout(set=0,binding=43,rgba32f) uniform writeonly image2D out_temporal_lc_bounce_path;
layout(set=0,binding=44,rgba32f) uniform writeonly image2D out_temporal_lc_bounce_reservoir;
layout(set=0,binding=46,rgba32f) uniform readonly image2D prev_temporal_lc_bounce_luminance;
layout(set=0,binding=47,rgba32f) uniform writeonly image2D out_temporal_lc_bounce_luminance;
layout(set=0,binding=48,rgba32f) uniform readonly image2D prev_temporal_lc_bounce_raw;
layout(set=0,binding=49,rgba32f) uniform writeonly image2D out_temporal_lc_bounce_raw;
layout(set=0,binding=50,rgba32f) uniform readonly image2D prev_first_bounce_direction;
layout(set=0,binding=51,rgba32f) uniform readonly image2D geometry_prev_position;
layout(set=0,binding=52,rgba32f) uniform readonly image2D prev_position_t;
layout(set=0,binding=53,rgba16f) uniform readonly image2D prev_normals_gs;
#include "noise.glsl"
#include "temporal_reservoir_rotation.glsl"
#include "bounce_path_config.glsl"
#include "ray_primary_common.glsl"
#include "ray_primary_hit.glsl"
#include "ray_lightmap.glsl"
#include "brdf.glsl"
#include "lightcache_geometry.glsl"
#include "lc_independent.glsl"

bool traceBounce(vec3 origin,vec3 direction,out RayPayloadPrimary payload,
    out RayPrimarySurface surface,out vec4 uv) {
    uv=vec4(0);
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq,tlas,gl_RayFlagsCullFrontFacingTrianglesEXT,
        GEOMETRY_BIT_OPAQUE|GEOMETRY_BIT_ALPHA_TEST,origin,0.0,direction,10000.0);
    while (rayQueryProceedEXT(rq)) {
        AlphaCandidateGeometry g=readCandidateAlphaGeometry(rq);
        uint texture_id=getKusok(g.kusok_index).material.tex_base_color;
        if (textureLod(textures[nonuniformEXT(texture_id)],g.uv,2.0).a>=0.1)
            rayQueryConfirmIntersectionEXT(rq);
    }
    if (rayQueryGetIntersectionTypeEXT(rq,true)!=gl_RayQueryCommittedIntersectionTriangleEXT) return false;
    primaryRayHit(rq,payload,surface);
    if (payload.hit_t.w<=0.0) return false;
    uv=rayLightmapUV(rq);
    return true;
}
vec3 cachedIrradiance(vec4 uv) {
    uint encoded=uv.z>0.0 ? lightcacheLookup(uv.xy) : 0u;
    if (encoded==0u || !lightcacheInCapacity(encoded-1u,ubo.ubo.res)) return vec3(0);
    ivec2 taps[4]; vec4 weights;
    if (!lightcacheBilinearFootprint(encoded-1u,uv.xy,ubo.ubo.res,taps,weights)) return vec3(0);
    vec3 color=vec3(0);
    for (int i=0;i<4;++i) color+=imageLoad(temporal_lc_radiance,taps[i]).rgb*weights[i];
    return max(color,vec3(0));
}
// A seed identifies every random dimension of the complete variable-length path.
// It never depends on the replay frame or receiving pixel.
vec3 tracePath(uint seed,vec3 P,vec3 G,out vec3 first_direction) {
    vec3 color=vec3(0), throughput=vec3(1);
    first_direction=vec3(0);
    for (uint bounce=0u;bounce<ubo.ubo.bounce_count;++bounce) {
        vec3 random=rand3_f01(uvec3(seed,bounce,0x1cb0u));
        float z=2.0*random.x-1.0;
        float phi=6.28318530718*random.y;
        float radius=sqrt(max(0.0,1.0-z*z));
        vec3 direction=vec3(radius*cos(phi),radius*sin(phi),z);
        if (dot(direction,G)<0.0) direction*=vec3(-1.0);
        if (bounce==0u) first_direction=direction;
        RayPayloadPrimary payload; RayPrimarySurface surface; vec4 uv;
        if (!traceBounce(P+G*0.01,direction,payload,surface,uv)) break;
        throughput*=surface.base_color_a.rgb*(1.0-surface.material_rmxx.g);
        color+=throughput*cachedIrradiance(uv);
        if (max(throughput.r,max(throughput.g,throughput.b))<=1e-3) break;
        P=payload.hit_t.xyz;
        G=normalDecode(surface.normals_gs.xy);
    }
    return color;
}
// Raw projection shared by the center and its four screen neighbors.
bool bounceHistoryPixel(ivec2 pixel,out ivec2 source) {
    source=ivec2(0);
    if (any(lessThan(pixel,ivec2(0))) || any(greaterThanEqual(pixel,ubo.ubo.res/2))) return false;
    if (imageLoad(position_t,pixel*2).w<=0.0) return false;
    vec4 clip=ubo.ubo.prev_proj*ubo.ubo.prev_view*vec4(imageLoad(geometry_prev_position,pixel*2).xyz,1);
    if (any(isnan(clip)) || any(isinf(clip)) || clip.w<=0.0) return false;
    vec2 uv=clip.xy/clip.w*0.5+0.5;
    if (any(lessThan(uv,vec2(0))) || any(greaterThanEqual(uv,vec2(1)))) return false;
    source=ivec2(floor(uv*vec2(ubo.ubo.res)))/2;
    return all(lessThan(source,ubo.ubo.res/2));
}
void main() {
    ivec2 pix=ivec2(gl_GlobalInvocationID.xy), res=ubo.ubo.res;
    if (any(greaterThanEqual(pix,res))) return;
    imageStore(out_indirect_diffuse,pix,vec4(0));
    imageStore(out_temporal_lc_bounce_raw,pix,vec4(0));
    imageStore(out_temporal_lc_bounce_luminance,pix,vec4(0));
    imageStore(out_first_bounce_direction,pix,vec4(0));
    imageStore(out_temporal_lc_bounce_path,pix,vec4(0));
    imageStore(out_temporal_lc_bounce_reservoir,pix,vec4(0));
    // Only the first quadrant belongs to the path/SH sample. Others stay zero.
    if (any(greaterThanEqual(pix,res/2)) || ubo.ubo.bounce_count==0u ||
        (ubo.ubo.renderer_flags & RENDERER_FLAG_DISABLE_GI)!=0u) return;
    ivec2 primary_pix=pix*2;
    vec4 position=imageLoad(position_t,primary_pix);
    if (position.w<=0.0) return;
    vec3 G=normalDecode(imageLoad(normals_gs,primary_pix).xy);
    uint selected_seed=xxhash32(uvec4(uvec2(pix),ubo.ubo.random_seed,0x66726573u)) & 8388607u;
    vec3 first_direction;
    vec3 selected=tracePath(selected_seed,position.xyz,G,first_direction);
    float history_cap=BOUNCE_PATH_MAX_EFFECTIVE_SAMPLES;
    float replay_ratio=1.0; bool transported=false; vec4 transported_reservoir=vec4(0);
    LCReservoir reservoir=LCReservoir(0,0,0);
    lcOffer(reservoir,lcPathTarget(selected),1.0,0.0);
    vec4 previous_position=imageLoad(geometry_prev_position,primary_pix);
    float restart=uintToFloat01(xxhash32(uvec4(uvec2(pix),ubo.ubo.random_seed,0x626c6966u)));
    ivec2 source;
    bool projected=bounceHistoryPixel(pix,source);
    if (projected) {
        const ivec2 offsets[4]=ivec2[4](ivec2(-1,0),ivec2(1,0),ivec2(0,-1),ivec2(0,1));
        bool duplicate=false;
        for (int i=0;i<4;++i) {
            ivec2 neighbor;
            if (bounceHistoryPixel(pix+offsets[i],neighbor) && all(equal(neighbor,source))) duplicate=true;
        }
        if (duplicate && uintToFloat01(xxhash32(uvec4(uvec2(pix),ubo.ubo.random_seed,0x626d6b6cu)))<BOUNCE_PATH_MAG_RESET_PROBABILITY)
            projected=false;
        uint rng=xxhash32(uvec4(uvec2(pix),ubo.ubo.random_seed,0x626d6167u));
        if (projected && duplicate && uintToFloat01(rng)<BOUNCE_PATH_MAG_REPLACEMENT_PROBABILITY) {
            int index=temporalHistoryNeighbor3x3Index(source.x,source.y,res.x/2,res.y/2,
                xxhash32(uvec4(uvec2(pix),ubo.ubo.random_seed,0x626e6233u)));
            source=ivec2(index%(res.x/2),index/(res.x/2));
        }
    }
    if (projected && restart>=BOUNCE_PATH_RESTART_PROBABILITY) {
        // Validate the actual half-resolution donor against its previous plane.
        // Tangential displacement from pixel quantization is deliberately ignored.
        vec4 donor=imageLoad(prev_position_t,source*2);
        vec3 donor_normal=normalDecode(imageLoad(prev_normals_gs,source*2).xy);
        float plane_error=abs(dot(previous_position.xyz-donor.xyz,donor_normal));
        if (donor.w<=0.0 || isnan(plane_error) || isinf(plane_error) ||
            plane_error>BOUNCE_PATH_REPROJECTION_PLANE_TOLERANCE) projected=false;
    } else projected=false;
    if (projected) {
        vec4 metadata=imageLoad(prev_temporal_lc_bounce_path,source);
        vec4 previous=imageLoad(prev_temporal_lc_bounce_reservoir,source);
        if (metadata.w==float(((ubo.ubo.frame_counter-1u)&65535u)+1u) &&
            metadata.z==float(ubo.ubo.bounce_count) && lcPathHistoryValid(previous)) {
            uint seed=uint(metadata.x);
            vec3 history_direction;
            vec3 history=tracePath(seed,position.xyz,G,history_direction);
            float target=lcPathTarget(history);
            float old_luminance=max(previous.x,1e-6);
            replay_ratio=target/old_luminance;
            float limit=BOUNCE_PATH_RADIANCE_RATIO;
            float confidence=clamp(replay_ratio<1.0 ?
                (replay_ratio-1.0/limit)/(1.0-1.0/limit) :
                (limit-replay_ratio)/(limit-1.0),0.0,1.0);
            float rejection=uintToFloat01(xxhash32(uvec4(uvec2(pix),ubo.ubo.random_seed,0x62636f6eu)));
            if (rejection<confidence) {
            // Replace exactly the selected historical candidate's contribution.
            // Replaying it does not add a sample to M.
            reservoir=LCReservoir(max(0.0,previous.y-previous.x)+target,previous.z,target);
            vec3 fresh=selected; vec3 fresh_direction=first_direction;
            selected=history; selected_seed=seed; first_direction=history_direction;
            float choose=uintToFloat01(xxhash32(uvec4(uvec2(pix),ubo.ubo.random_seed,0x7073656cu)));
            if (lcOffer(reservoir,lcPathTarget(fresh),1.0,choose)) {
                selected=fresh;
                selected_seed=xxhash32(uvec4(uvec2(pix),ubo.ubo.random_seed,0x66726573u)) & 8388607u;
                first_direction=fresh_direction;
            }
        }
    }
            }
    float W=transported ? transported_reservoir.w : lcNormalization(reservoir);
    imageStore(out_temporal_lc_bounce_raw,pix,vec4(selected,float((ubo.ubo.frame_counter&65535u)+1u)));
    imageStore(out_temporal_lc_bounce_luminance,pix,vec4(lcWeight(selected*W),lcWeight(selected),float((ubo.ubo.frame_counter&65535u)+1u),replay_ratio));
    float weight=W;
    imageStore(out_indirect_diffuse,pix,vec4(clamp(selected*weight,vec3(0),vec3(65504)),0));
    imageStore(out_first_bounce_direction,pix,vec4(first_direction,0));
    imageStore(out_temporal_lc_bounce_path,pix,vec4(float(selected_seed),0.0,
        float(ubo.ubo.bounce_count),float((ubo.ubo.frame_counter & 65535u)+1u)));
    imageStore(out_temporal_lc_bounce_reservoir,pix,transported ? transported_reservoir : lcEncodePath(reservoir,history_cap));
}
