#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_shader_16bit_storage : require
#define GLSL
#include "ray_interop.h"
#undef GLSL
#define RAY_QUERY
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=1) uniform accelerationStructureEXT tlas;
layout(set=0,binding=2) uniform UBO { UniformBuffer ubo; } ubo;
layout(set=0,binding=6) uniform sampler2D textures[MAX_TEXTURES];
layout(set=0,binding=7,std430) readonly buffer SBOLights { LightsMetadata m; } lights;
layout(set=0,binding=8,align=1) readonly buffer UBOLightClusters {
    LightCluster clusters_[MAX_LIGHT_CLUSTERS];
} light_grid;
layout(set=0,binding=21,rgba16f) uniform writeonly image2D out_lc_polygon;
layout(set=0,binding=30,std430) readonly buffer ModelHeaders { ModelHeader a[]; } model_headers;
layout(set=0,binding=31,std430) readonly buffer Kusochki { Kusok a[]; } kusochki;
layout(set=0,binding=32,std430) readonly buffer Indices { uint16_t a[]; } indices;
layout(set=0,binding=33,std430) readonly buffer Vertices { Vertex a[]; } vertices;
#include "utils.glsl"
#include "noise.glsl"
#include "brdf.glsl"
const float shadow_offset_fudge = 0.01;
#include "light_common.glsl"
#include "lightcache_geometry.glsl"
#include "lc_independent.glsl"

vec3 polygonRadiance(PolygonLight l, vec3 P, vec3 N, vec3 random) {
    uint offset = l.vertices_count_offset & 65535u, count = l.vertices_count_offset >> 16;
    if (count < 3u || l.area <= 0.0) return vec3(0);
    vec3 a = lights.m.polygon_vertices[offset].xyz;
    float total = 0.0;
    for (uint i=1u; i+1u<count; ++i)
        total += length(cross(lights.m.polygon_vertices[offset+i].xyz-a,
            lights.m.polygon_vertices[offset+i+1u].xyz-a))*0.5;
    float selection=random.z*total;
    vec3 b=a,c=a;
    for (uint i=1u; i+1u<count; ++i) {
        vec3 v = lights.m.polygon_vertices[offset+i].xyz;
        vec3 w = lights.m.polygon_vertices[offset+i+1u].xyz;
        float area = length(cross(v-a,w-a))*0.5;
        b=v; c=w;
        selection-=area;
        if (selection<0.0) break;
    }
    float s = sqrt(random.x);
    vec3 d = a*(1.0-s)+b*(s*(1.0-random.y))+c*(s*random.y)-P;
    float distance = length(d);
    if (distance < 0.02) return vec3(0);
    vec3 L = d/distance;
    vec3 value = lcDiffuse(l.emissive*(total*max(-dot(l.plane.xyz,L),0.0)/(distance*distance)),N,L);
    return lcWeight(value)>0.0 && !shadowed(P,L,distance) ? value : vec3(0);
}
// Fixed emitter coordinates for this original LM texel/light pair, for every frame.
vec3 lightSampleRandom(uint index,uint light_id) {
    LightcacheProbe p=lightcache_geometry.probes[index];
    uvec2 texel=uvec2(p.lm_s,p.lm_t)+2u*uvec2(p.local_index%p.width,p.local_index/p.width);
    return rand3_f01(uvec3(texel,light_id^0x1c402u));
}
void main() {
    ivec2 pix=ivec2(gl_GlobalInvocationID.xy), res=ubo.ubo.res;
    if (any(greaterThanEqual(pix,res))) return;
    vec3 value=vec3(0);
    uint index=uint(pix.y*res.x+pix.x);
    if (lightcacheInCapacity(index,res) && !lightcacheUpdateDisabled()) {
        vec3 P,N; lightcacheSurface(index,P,N);

            // Same world-space grid and packed cluster list as legacy lighting.
            ivec3 cell=ivec3(floor(P/LIGHT_GRID_CELL_SIZE))-lights.m.grid_min_cell;
            if (all(greaterThanEqual(cell,ivec3(0))) && all(lessThan(cell,lights.m.grid_size))) {
                uint cluster=uint(dot(cell,ivec3(1,lights.m.grid_size.x,
                    lights.m.grid_size.x*lights.m.grid_size.y)));
                if (cluster<MAX_LIGHT_CLUSTERS) {
                    uint count=min(uint(light_grid.clusters_[cluster].num_polygons),MAX_VISIBLE_SURFACE_LIGHTS);
                    for (uint j=0u;j<count;++j) {
                        uint id=uint(light_grid.clusters_[cluster].polygons[j]);
                        if (id>=lights.m.num_polygons) continue;
                        vec3 random=lightSampleRandom(index,id);
                        value+=polygonRadiance(lights.m.polygons[id],P,N,random);
                    }
                }
            }

    }
    imageStore(out_lc_polygon,pix,vec4(clamp(value,vec3(0),vec3(65504)),0));
}
