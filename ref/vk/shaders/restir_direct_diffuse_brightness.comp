#version 460 core
#extension GL_GOOGLE_include_directive : require

#define GLSL
#include "ray_interop.h"
#undef GLSL

#define RESTIR_COMMON_NO_LIGHTING
#include "restir_common.glsl"
#include "denoiser_config.glsl"

#define STABILIZE_RESERVOIRS_KERNEL 1
#define STABILIZE_RESERVOIRS_CENTER_WEIGHT 0.25
#define STABILIZE_RESERVOIRS_NEIGHBOR_WEIGHT 1.0

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D out_restir_stabilize_metric;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D diffuse_direct_restir;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D specular_direct_restir;
layout(set = 0, binding = 2) uniform UBO { UniformBuffer ubo; } ubo;

float reservoir_pdf(Reservoir r) {
    const float denom = max(r.checked_count * r.w_clamped, 1e-6);
    return r.w_sum / denom;
}

float diffuse_reservoir_luma_estimate(ivec2 pix) {
    bool out_of_bound;
    Reservoir r = loadReservoir(imageLoad(diffuse_direct_restir, pix), out_of_bound);
    if (out_of_bound || r.w_clamped <= 0.0 || r.checked_count <= 0.0) {
        return 0.0;
    }

    const float pdf = max(reservoir_pdf(r), 0.0);
    const float w_full = max(r.w_full, 0.0);
    return w_full * pdf;
}

float specular_reservoir_luma_estimate(ivec2 pix) {
    bool out_of_bound;
    Reservoir r = loadReservoir(imageLoad(specular_direct_restir, pix), out_of_bound);
    if (out_of_bound || r.w_clamped <= 0.0 || r.checked_count <= 0.0) {
        return 0.0;
    }

    const float pdf = max(reservoir_pdf(r), 0.0);
    const float w_full = max(r.w_full, 0.0);
    return w_full * pdf;
}

void main() {
    const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 res = ivec2(vec2(ubo.ubo.res) * ubo.ubo.resScale);
    if (any(greaterThanEqual(pix, res))) {
        return;
    }

#if !DENOISER_ENABLE_STABILIZE_RESERVOIRS
    imageStore(out_restir_stabilize_metric, pix, vec4(0.0));
    return;
#endif

    const vec2 raw_luma = vec2(diffuse_reservoir_luma_estimate(pix), specular_reservoir_luma_estimate(pix));

    const float center_weight_cfg = max(STABILIZE_RESERVOIRS_CENTER_WEIGHT, 0.0);
    const float neighbor_weight_cfg = max(STABILIZE_RESERVOIRS_NEIGHBOR_WEIGHT, 0.0);
    vec2 blur_sum = vec2(0.0);
    float blur_weight = 0.0;
    const ivec2 taps[5] = ivec2[](
        pix,
        pix + ivec2( 1, 0),
        pix + ivec2(-1, 0),
        pix + ivec2( 0, 1),
        pix + ivec2( 0,-1)
    );
    const float tap_weights[5] = float[](
        center_weight_cfg,
        neighbor_weight_cfg,
        neighbor_weight_cfg,
        neighbor_weight_cfg,
        neighbor_weight_cfg
    );
    for (int i = 0; i < 5; ++i) {
        const ivec2 q = taps[i];
        if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, res))) {
            continue;
        }

        const float tap_weight = tap_weights[i];
        if (tap_weight <= 0.0) {
            continue;
        }

        blur_sum += vec2(diffuse_reservoir_luma_estimate(q), specular_reservoir_luma_estimate(q)) * tap_weight;
        blur_weight += tap_weight;
    }

    const vec2 blur_luma = (blur_weight > 0.0) ? (blur_sum / blur_weight) : raw_luma;
    imageStore(out_restir_stabilize_metric, pix, vec4(blur_luma, 0.0, 0.0));
}
