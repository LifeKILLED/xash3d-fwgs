#version 460 core
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_control_flow_attributes2 : require

#define GLSL
#include "ray_interop.h"
#undef GLSL

#include "denoiser_config.glsl"

#define VARIANCE_MIN 0.5
#define VARIANCE_MAX 1.0
#define MAX_RESTIR_NORM 8.0
#define MIN_ALPHA 0.02
#define REPROJECTION_BILINEAR 1
#define REPROJECTION_BILINEAR_MOTION_THRESHOLD 1.0

#define CONF_KERNEL 1

#include "utils.glsl"
#include "noise.glsl"
#include "color_spaces.glsl"

layout(local_size_x=8, local_size_y=8) in;

layout(set = 0, binding = 1, rgba16f) uniform image2D out_diffuse_asvgf;
layout(set = 0, binding = 2, rgba16f) uniform image2D out_specular_asvgf;

layout(set = 0, binding = 3, rgba16f) uniform readonly image2D diffuse_direct_reconstructed;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D specular_direct_reconstructed;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D diffuse_shadow_mask;
layout(set = 0, binding = 6, rgba32f) uniform readonly image2D geometry_prev_position;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D normals_gs;
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D diffuse_shadow_mask_normalized_reconstructed;

layout(set = 0, binding=15, rgba32f) uniform image2D prev_temporal_asvgf_diffuse;
layout(set = 0, binding=16, rgba32f) uniform image2D prev_temporal_asvgf_specular;
layout(set = 0, binding=17, rgba32f) uniform image2D out_temporal_asvgf_diffuse;
layout(set = 0, binding=18, rgba32f) uniform image2D out_temporal_asvgf_specular;

layout(set = 0, binding = 9, rgba16f) uniform readonly image2D reprojection_uv;
layout(set = 0, binding = 12, rgba16f) uniform image2D prev_temporal_asvgf_shadow_mask_normalized;
layout(set = 0, binding = 13, rgba16f) uniform image2D out_temporal_asvgf_shadow_mask_normalized;
layout(set = 0, binding = 14, rgba16f) uniform image2D out_asvgf_shadow_mask_normalized;

layout(set = 0, binding = 10) uniform UBO { UniformBuffer ubo; } ubo;

void processLobeTemporal(
    vec3 curr,
    vec3 hist,
    float conf,
    out vec3 outColor,
    out float outVar,
    out float length,
    float prev_length
){
    length = prev_length + 1.0;

    float nonlinear_conf = smoothstep(0.5, 1.0, conf);
    float conf_influence = clamp(DENOISER_ASVGF_CONFIDENCE_INFLUENCE, 0.0, 1.0);
    float confidence_keep = mix(1.0, nonlinear_conf, conf_influence);
    length = mix(1.0, length, confidence_keep);

    float alpha = max(MIN_ALPHA, 1.0 / length);

    //outColor = vec3(nonlinear_conf); // debug
    outColor = mix(hist, curr, alpha);

    vec3 d = curr - hist;
    outVar = clamp(dot(d, d), VARIANCE_MIN, VARIANCE_MAX);

    //outColor = curr; // debug current frame
}

bool gatherBilinearTaps(
    vec2 reproj_uv,
    ivec2 res,
    vec3 center_pos,
    vec3 center_geom_normal,
    float inv_center_dist,
    float world_texel_size,
    out ivec2 taps[4],
    out float weights[4])
{
    const ivec2 base = ivec2(floor(reproj_uv));
    const vec2 frac_uv = fract(reproj_uv);

    taps[0] = base + ivec2(0, 0);
    taps[1] = base + ivec2(1, 0);
    taps[2] = base + ivec2(0, 1);
    taps[3] = base + ivec2(1, 1);

    weights[0] = (1.0 - frac_uv.x) * (1.0 - frac_uv.y);
    weights[1] = frac_uv.x * (1.0 - frac_uv.y);
    weights[2] = (1.0 - frac_uv.x) * frac_uv.y;
    weights[3] = frac_uv.x * frac_uv.y;

    float weight_sum = 0.0;
    for (int i = 0; i < 4; ++i) {
        if (any(lessThan(taps[i], ivec2(0))) || any(greaterThanEqual(taps[i], res))) {
            weights[i] = 0.0;
        } else {
            const vec3 p1 = imageLoad(geometry_prev_position, taps[i]).xyz;
            const float wp = positionEdgeStopWithWorldTexel(
                p1 - center_pos,
                center_geom_normal,
                inv_center_dist,
                DENOISER_POSITION_PLANE_THRESHOLD,
                world_texel_size
            );
            if (wp == 0.0) {
                weights[i] = 0.0;
            }
        }
        weight_sum += weights[i];
    }

    if (weight_sum <= 0.0) {
        return false;
    }

    for (int i = 0; i < 4; ++i) {
        weights[i] /= weight_sum;
    }

    return true;
}

bool gatherNearestTap(vec2 reproj_uv, ivec2 res, out ivec2 tap)
{
    tap = ivec2(floor(reproj_uv + vec2(0.5)));
    return all(greaterThanEqual(tap, ivec2(0))) && all(lessThan(tap, res));
}

vec4 loadBilinearPrevTemporalDiffuse(ivec2 taps[4], float weights[4])
{
    vec4 result = vec4(0.0);
    for (int i = 0; i < 4; ++i) {
        if (weights[i] > 0.0) {
            result += imageLoad(prev_temporal_asvgf_diffuse, taps[i]) * weights[i];
        }
    }
    return result;
}

vec4 loadBilinearPrevTemporalSpecular(ivec2 taps[4], float weights[4])
{
    vec4 result = vec4(0.0);
    for (int i = 0; i < 4; ++i) {
        if (weights[i] > 0.0) {
            result += imageLoad(prev_temporal_asvgf_specular, taps[i]) * weights[i];
        }
    }
    return result;
}

vec4 loadBilinearPrevTemporalShadowMask(ivec2 taps[4], float weights[4])
{
    vec4 result = vec4(0.0);
    for (int i = 0; i < 4; ++i) {
        if (weights[i] > 0.0) {
            result += imageLoad(prev_temporal_asvgf_shadow_mask_normalized, taps[i]) * weights[i];
        }
    }
    return result;
}

void main() {
    const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 res = ivec2(vec2(ubo.ubo.res) * ubo.ubo.resScale);

	if (any(greaterThanEqual(pix, res)))
		return;

    const vec2 prev_uv = imageLoad(reprojection_uv, pix).xy;
    const vec3 center_pos = imageLoad(geometry_prev_position, pix).xyz;
    const vec3 center_geom_normal = normalDecode(imageLoad(normals_gs, pix).xy);
    const float inv_center_dist = 1.0 / max(length(center_pos), 1.0);
    const vec3 cam_pos = (ubo.ubo.inv_view * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    const float world_texel_size = estimateWorldTexelSizeFromCenter(
        pix, res, cam_pos, center_pos, ubo.ubo.inv_proj, ubo.ubo.inv_view, DENOISER_POSITION_TEXEL_SIZE_MARGIN);

    const vec3 curr_diffuse = imageLoad(diffuse_direct_reconstructed, pix).rgb;
    const vec3 curr_specular = imageLoad(specular_direct_reconstructed, pix).rgb;
    float curr_shadow_mask_norm_diff = imageLoad(diffuse_shadow_mask_normalized_reconstructed, pix).r;

    if (DENOISER_ENABLE_REPROJECTION == 0) {
        imageStore(out_diffuse_asvgf, pix, vec4(curr_diffuse, VARIANCE_MIN));
        imageStore(out_specular_asvgf, pix, vec4(curr_specular, VARIANCE_MIN));
        imageStore(out_temporal_asvgf_diffuse, pix, vec4(curr_diffuse, 1.0));
        imageStore(out_temporal_asvgf_specular, pix, vec4(curr_specular, 1.0));
        vec3 curr_shadow_norm = vec3(curr_shadow_mask_norm_diff);
        imageStore(out_asvgf_shadow_mask_normalized, pix, vec4(curr_shadow_norm, 1.0));
        imageStore(out_temporal_asvgf_shadow_mask_normalized, pix, vec4(curr_shadow_norm, 1.0));
        return;
    }

    float conf_weight = 0.0;
    float conf_diffuse = 0.0;
    float conf_specular = 0.0;
    for (int x = -CONF_KERNEL; x <= CONF_KERNEL; x++) {
        for (int y = -CONF_KERNEL; y <= CONF_KERNEL; y++) {
            const ivec2 p = pix + ivec2(x, y);
            if (all(greaterThanEqual(p, ivec2(0.))) && all(lessThan(p, res))) {
                conf_weight += 1.0;
                conf_diffuse += clamp(imageLoad(diffuse_direct_reconstructed, p).w, 0.0, 1.0);
                conf_specular += clamp(imageLoad(specular_direct_reconstructed, p).w, 0.0, 1.0);
            }
        }
    }
    if (conf_weight > 0.0) {
        conf_diffuse /= conf_weight;
        conf_specular /= conf_weight;
    }
    conf_diffuse = clamp(conf_diffuse, 0.0, 1.0);
    conf_specular = clamp(conf_specular, 0.0, 1.0);
    // conf_diffuse *= conf_diffuse;
    // conf_specular *= conf_specular;

    vec3 diffuse = curr_diffuse;
    float variance_diffuse = 1.0;
    float history_length_diffuse = 1.0;

    vec3 specular = curr_specular;
    float variance_specular = 1.0;
    float history_length_specular = 1.0;

    vec3 prev_diff = curr_diffuse;
    vec3 prev_spec = curr_specular;
    vec3 prev_shadow_norm = vec3(curr_shadow_mask_norm_diff);
    float prev_len_diff = 0.0;
    float prev_len_spec = 0.0;

    const float reproj_motion = length(prev_uv - vec2(pix));

#if (REPROJECTION_BILINEAR)
    const bool use_bilinear = reproj_motion > REPROJECTION_BILINEAR_MOTION_THRESHOLD;
#else 
    const bool use_bilinear = false;
#endif

    if (use_bilinear) {
        ivec2 reproj_taps[4];
        float reproj_weights[4];
        const bool has_reprojection = gatherBilinearTaps(
            prev_uv, res, center_pos, center_geom_normal, inv_center_dist, world_texel_size, reproj_taps, reproj_weights);

        if (has_reprojection) {
            vec4 pd = loadBilinearPrevTemporalDiffuse(reproj_taps, reproj_weights);
            vec4 ps = loadBilinearPrevTemporalSpecular(reproj_taps, reproj_weights);
            vec4 pm = loadBilinearPrevTemporalShadowMask(reproj_taps, reproj_weights);
            prev_diff = pd.rgb;
            prev_len_diff = pd.w;
            prev_spec = ps.rgb;
            prev_len_spec = ps.w;
            prev_shadow_norm = pm.rgb;
        }
    } else {
        ivec2 nearest_tap;
        if (gatherNearestTap(prev_uv, res, nearest_tap)) {
            vec4 pd = imageLoad(prev_temporal_asvgf_diffuse, nearest_tap);
            vec4 ps = imageLoad(prev_temporal_asvgf_specular, nearest_tap);
            vec4 pm = imageLoad(prev_temporal_asvgf_shadow_mask_normalized, nearest_tap);
            prev_diff = pd.rgb;
            prev_len_diff = pd.w;
            prev_spec = ps.rgb;
            prev_len_spec = ps.w;
            prev_shadow_norm = pm.rgb;
        }
    }

    vec3 out_diff = vec3(0.);
    vec3 out_spec = vec3(0.);
    float var_diff = 0., var_spec = 0.;
    float len_diff = 0., len_spec = 0.;

    processLobeTemporal(curr_diffuse, prev_diff, conf_diffuse,
                        out_diff, var_diff, len_diff, prev_len_diff);

    processLobeTemporal(curr_specular, prev_spec, conf_specular,
                       out_spec, var_spec, len_spec, prev_len_spec);

    float alpha_diff = max(MIN_ALPHA, 1.0 / max(len_diff, 1.0));
    float out_shadow_diff = mix(prev_shadow_norm.r, curr_shadow_mask_norm_diff, alpha_diff);
    vec3 out_shadow_norm = vec3(out_shadow_diff);
 
    imageStore(out_diffuse_asvgf, pix, vec4(out_diff, var_diff));
    imageStore(out_temporal_asvgf_diffuse, pix, vec4(out_diff, len_diff));

    imageStore(out_specular_asvgf, pix, vec4(out_spec, var_spec));
    imageStore(out_temporal_asvgf_specular, pix, vec4(out_spec, len_spec));
    imageStore(out_asvgf_shadow_mask_normalized, pix, vec4(out_shadow_norm, 1.0));
    imageStore(out_temporal_asvgf_shadow_mask_normalized, pix, vec4(out_shadow_norm, 1.0));
}
