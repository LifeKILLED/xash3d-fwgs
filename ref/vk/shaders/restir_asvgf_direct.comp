void neighborhoodColorBoundsDiffuse(
    ivec2 p,
    ivec2 res,
    out vec3 outMinC,
    out vec3 outMaxC,
    out vec3 outMeanC,
    out vec3 outSigmaC)
{
    outMinC = vec3(1e20);
    outMaxC = vec3(-1e20);
    vec3 sumC = vec3(0.0);
    vec3 sumC2 = vec3(0.0);
    float count = 0.0;

    for (int y = -DENOISER_REPROJECTION_FIREFLY_RADIUS; y <= DENOISER_REPROJECTION_FIREFLY_RADIUS; ++y) {
        for (int x = -DENOISER_REPROJECTION_FIREFLY_RADIUS; x <= DENOISER_REPROJECTION_FIREFLY_RADIUS; ++x) {
            ivec2 q = clamp(p + ivec2(x, y), ivec2(0), res - 1);
            vec3 c = imageLoad(diffuse_direct_reconstructed, q).rgb;
            outMinC = min(outMinC, c);
            outMaxC = max(outMaxC, c);
            sumC += c;
            sumC2 += c * c;
            count += 1.0;
        }
    }

    outMeanC = sumC / max(count, 1.0);
    vec3 varC = max(sumC2 / max(count, 1.0) - outMeanC * outMeanC, vec3(0.0));
    outSigmaC = sqrt(varC);
}

void neighborhoodColorBoundsSpecular(
