    outSigmaC = sqrt(varC);
}

vec3 clampHistoryWithNeighborhood(
    vec3 historyC,
    vec3 minC,
    vec3 maxC,
    vec3 meanC,
    vec3 sigmaC)
{
    vec3 sigmaBand = sigmaC * max(DENOISER_REPROJECTION_FIREFLY_SIGMA, 0.01);
    vec3 low = max(minC, meanC - sigmaBand);
    vec3 high = min(maxC, meanC + sigmaBand);
    vec3 clampedC = clamp(historyC, low, high);
    return mix(historyC, clampedC, clamp(DENOISER_REPROJECTION_FIREFLY_STRENGTH, 0.0, 1.0));
}

float gatherConfidenceDiffuseBoxK1(ivec2 p, ivec2 res) {
    float sumConf = 0.0;
    float count = 0.0;
    for (int oy = -1; oy <= 1; ++oy) {
        for (int ox = -1; ox <= 1; ++ox) {
            ivec2 q = clamp(p + ivec2(ox, oy), ivec2(0), res - 1);
            sumConf += clamp(imageLoad(diffuse_direct_reconstructed, q).a, 0.0, 1.0);
            count += 1.0;
        }
    }
    return sumConf / max(count, 1.0);
}

float gatherConfidenceSpecularBoxK1(ivec2 p, ivec2 res) {
    float sumConf = 0.0;
    float count = 0.0;
    for (int oy = -1; oy <= 1; ++oy) {
        for (int ox = -1; ox <= 1; ++ox) {
            ivec2 q = clamp(p + ivec2(ox, oy), ivec2(0), res - 1);
            sumConf += clamp(imageLoad(specular_direct_reconstructed, q).a, 0.0, 1.0);
            count += 1.0;
        }
    }
    return sumConf / max(count, 1.0);
}

void main() {
    const ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 res = ivec2(vec2(ubo.ubo.res) * ubo.ubo.resScale);

	if (any(greaterThanEqual(pix, res)))
		return;

    const vec2 prev_uv = imageLoad(reprojection_uv, pix).xy;
    const vec3 center_pos = imageLoad(geometry_prev_position, pix).xyz;
    const vec3 center_geom_normal = normalDecode(imageLoad(normals_gs, pix).xy);
    const float inv_center_dist = 1.0 / max(length(center_pos), 1.0);
    const vec3 cam_pos = (ubo.ubo.inv_view * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    const float world_texel_size = estimateWorldTexelSizeFromCenter(
        pix, res, cam_pos, center_pos, ubo.ubo.inv_proj, ubo.ubo.inv_view, DENOISER_POSITION_TEXEL_SIZE_MARGIN);

    const vec3 curr_diffuse = imageLoad(diffuse_direct_reconstructed, pix).rgb;
    const vec3 curr_specular = imageLoad(specular_direct_reconstructed, pix).rgb;
    AsvgfMoments curr_mom_diff = momentsFromLuminance(safeLum(curr_diffuse), 1.0);
    AsvgfMoments curr_mom_spec = momentsFromLuminance(safeLum(curr_specular), 1.0);
    float curr_shadow_mask_norm_diff = imageLoad(diffuse_shadow_mask_normalized_reconstructed, pix).r;
    float curr_conf_diffuse = gatherConfidenceDiffuseBoxK1(pix, res);
    float curr_conf_specular = gatherConfidenceSpecularBoxK1(pix, res);

    if (DENOISER_ENABLE_REPROJECTION == 0) {
#if DENOISER_DEBUG_CONFIDENCE_VIEW
        vec3 conf_vis_diff = confidenceDebugColor(curr_conf_diffuse);
        vec3 conf_vis_spec = confidenceDebugColor(curr_conf_specular);
        imageStore(out_diffuse_asvgf, pix, vec4(conf_vis_diff, 1.0));
        imageStore(out_specular_asvgf, pix, vec4(conf_vis_spec, 1.0));
        imageStore(out_temporal_asvgf_diffuse, pix, vec4(conf_vis_diff, 1.0));
        imageStore(out_temporal_asvgf_specular, pix, vec4(conf_vis_spec, 1.0));
        imageStore(out_temporal_asvgf_moments_diffuse, pix, encodeMoments(curr_mom_diff));
        imageStore(out_temporal_asvgf_moments_specular, pix, encodeMoments(curr_mom_spec));
        vec3 curr_shadow_norm_dbg = vec3(curr_shadow_mask_norm_diff);
        imageStore(out_asvgf_shadow_mask_normalized, pix, vec4(curr_shadow_norm_dbg, 1.0));
        imageStore(out_temporal_asvgf_shadow_mask_normalized, pix, vec4(curr_shadow_norm_dbg, 1.0));
        return;
#endif
        imageStore(out_diffuse_asvgf, pix, vec4(curr_diffuse, VARIANCE_MIN));
        imageStore(out_specular_asvgf, pix, vec4(curr_specular, VARIANCE_MIN));
        imageStore(out_temporal_asvgf_diffuse, pix, vec4(curr_diffuse, 1.0));
        imageStore(out_temporal_asvgf_specular, pix, vec4(curr_specular, 1.0));
        imageStore(out_temporal_asvgf_moments_diffuse, pix, encodeMoments(curr_mom_diff));
        imageStore(out_temporal_asvgf_moments_specular, pix, encodeMoments(curr_mom_spec));
        vec3 curr_shadow_norm = vec3(curr_shadow_mask_norm_diff);
        imageStore(out_asvgf_shadow_mask_normalized, pix, vec4(curr_shadow_norm, 1.0));
        imageStore(out_temporal_asvgf_shadow_mask_normalized, pix, vec4(curr_shadow_norm, 1.0));
        return;
    }

    float conf_diffuse = curr_conf_diffuse;
    float conf_specular = curr_conf_specular;

    vec4 prev_diff_self = imageLoad(prev_temporal_asvgf_diffuse, pix);
    vec4 prev_spec_self = imageLoad(prev_temporal_asvgf_specular, pix);
    vec4 prev_mom_diff_self = imageLoad(prev_temporal_asvgf_moments_diffuse, pix);
    vec4 prev_mom_spec_self = imageLoad(prev_temporal_asvgf_moments_specular, pix);

    vec3 prev_diff = prev_diff_self.rgb;
    vec3 prev_spec = prev_spec_self.rgb;
    vec3 prev_shadow_norm = vec3(curr_shadow_mask_norm_diff);
    AsvgfMoments prev_mom_diff = decodeMoments(prev_mom_diff_self);
    AsvgfMoments prev_mom_spec = decodeMoments(prev_mom_spec_self);

    const float reproj_motion = length(prev_uv - vec2(pix));

#if (REPROJECTION_BILINEAR)
    const bool use_bilinear = reproj_motion > REPROJECTION_BILINEAR_MOTION_THRESHOLD;
#else 
    const bool use_bilinear = false;
#endif

    if (use_bilinear) {
        ivec2 reproj_taps[4];
        float reproj_weights[4];
        const bool has_reprojection = gatherBilinearTaps(
            prev_uv, res, center_pos, center_geom_normal, inv_center_dist, world_texel_size, reproj_taps, reproj_weights);

        if (has_reprojection) {
            vec4 pd = loadBilinearPrevTemporalDiffuse(reproj_taps, reproj_weights);
            vec4 ps = loadBilinearPrevTemporalSpecular(reproj_taps, reproj_weights);
            vec4 pmd = loadBilinearPrevTemporalMomentsDiffuse(reproj_taps, reproj_weights);
            vec4 pms = loadBilinearPrevTemporalMomentsSpecular(reproj_taps, reproj_weights);
            vec4 pm = loadBilinearPrevTemporalShadowMask(reproj_taps, reproj_weights);
            prev_diff = pd.rgb;
            prev_spec = ps.rgb;
            prev_mom_diff = decodeMoments(pmd);
            prev_mom_spec = decodeMoments(pms);
            prev_shadow_norm = pm.rgb;
        }
    } else {
        ivec2 nearest_tap;
        if (gatherNearestTap(prev_uv, res, nearest_tap)) {
            vec4 pd = imageLoad(prev_temporal_asvgf_diffuse, nearest_tap);
            vec4 ps = imageLoad(prev_temporal_asvgf_specular, nearest_tap);
            vec4 pmd = imageLoad(prev_temporal_asvgf_moments_diffuse, nearest_tap);
            vec4 pms = imageLoad(prev_temporal_asvgf_moments_specular, nearest_tap);
            vec4 pm = imageLoad(prev_temporal_asvgf_shadow_mask_normalized, nearest_tap);
            prev_diff = pd.rgb;
            prev_spec = ps.rgb;
            prev_mom_diff = decodeMoments(pmd);
            prev_mom_spec = decodeMoments(pms);
            prev_shadow_norm = pm.rgb;
        }
    }

#if DENOISER_REPROJECTION_FIREFLY_CLAMP_ENABLE
    vec3 diffMinC, diffMaxC, diffMeanC, diffSigmaC;
    neighborhoodColorBoundsDiffuse(pix, res, diffMinC, diffMaxC, diffMeanC, diffSigmaC);
    prev_diff = clampHistoryWithNeighborhood(prev_diff, diffMinC, diffMaxC, diffMeanC, diffSigmaC);

    vec3 specMinC, specMaxC, specMeanC, specSigmaC;
    neighborhoodColorBoundsSpecular(pix, res, specMinC, specMaxC, specMeanC, specSigmaC);
    prev_spec = clampHistoryWithNeighborhood(prev_spec, specMinC, specMaxC, specMeanC, specSigmaC);
#endif

    float disocc_diff = disocclusionMetric(curr_diffuse, prev_diff);
    float disocc_spec = disocclusionMetric(curr_specular, prev_spec);

    vec3 out_diff = vec3(0.0);
    vec3 out_spec = vec3(0.0);
    float var_diff = VARIANCE_MIN;
    float var_spec = VARIANCE_MIN;
    float alpha_diff = DENOISER_ASVGF_TEMPORAL_ALPHA_MAX;
    float alpha_spec = DENOISER_ASVGF_TEMPORAL_ALPHA_MAX;
    AsvgfMoments out_mom_diff = curr_mom_diff;
    AsvgfMoments out_mom_spec = curr_mom_spec;

    processLobeTemporal(curr_diffuse, prev_diff, curr_mom_diff, prev_mom_diff, conf_diffuse, disocc_diff,
                        out_diff, out_mom_diff, var_diff, alpha_diff);

    processLobeTemporal(curr_specular, prev_spec, curr_mom_spec, prev_mom_spec, conf_specular, disocc_spec,
                        out_spec, out_mom_spec, var_spec, alpha_spec);

    float out_shadow_diff = mix(prev_shadow_norm.r, curr_shadow_mask_norm_diff, alpha_diff);
    vec3 out_shadow_norm = vec3(out_shadow_diff);

#if DENOISER_DEBUG_CONFIDENCE_VIEW
    vec3 conf_vis_diff = confidenceDebugColor(curr_conf_diffuse);
    vec3 conf_vis_spec = confidenceDebugColor(curr_conf_specular);
    imageStore(out_diffuse_asvgf, pix, vec4(conf_vis_diff, 1.0));
    imageStore(out_temporal_asvgf_diffuse, pix, vec4(conf_vis_diff, 1.0));
    imageStore(out_specular_asvgf, pix, vec4(conf_vis_spec, 1.0));
    imageStore(out_temporal_asvgf_specular, pix, vec4(conf_vis_spec, 1.0));
    imageStore(out_temporal_asvgf_moments_diffuse, pix, encodeMoments(out_mom_diff));
    imageStore(out_temporal_asvgf_moments_specular, pix, encodeMoments(out_mom_spec));
    imageStore(out_asvgf_shadow_mask_normalized, pix, vec4(out_shadow_norm, 1.0));
    imageStore(out_temporal_asvgf_shadow_mask_normalized, pix, vec4(out_shadow_norm, 1.0));
    return;
#endif

    imageStore(out_diffuse_asvgf, pix, vec4(out_diff, var_diff));
    imageStore(out_temporal_asvgf_diffuse, pix, vec4(out_diff, out_mom_diff.history));
    imageStore(out_temporal_asvgf_moments_diffuse, pix, encodeMoments(out_mom_diff));

    imageStore(out_specular_asvgf, pix, vec4(out_spec, var_spec));
    imageStore(out_temporal_asvgf_specular, pix, vec4(out_spec, out_mom_spec.history));
    imageStore(out_temporal_asvgf_moments_specular, pix, encodeMoments(out_mom_spec));
    imageStore(out_asvgf_shadow_mask_normalized, pix, vec4(out_shadow_norm, 1.0));
    imageStore(out_temporal_asvgf_shadow_mask_normalized, pix, vec4(out_shadow_norm, 1.0));
}
