        for (int x = -DENOISER_REPROJECTION_FIREFLY_RADIUS; x <= DENOISER_REPROJECTION_FIREFLY_RADIUS; ++x) {
            ivec2 q = clamp(p + ivec2(x, y), ivec2(0), res - 1);
            vec3 c = imageLoad(specular_direct_reconstructed, q).rgb;
            outMinC = min(outMinC, c);
            outMaxC = max(outMaxC, c);
