struct AsvgfMoments {
    float m1;
    float m2;
    float m3;
    float history;
};

float asvgfClamp01(float x) {
    return clamp(x, 0.0, 1.0);
}

float sanitizeFiniteNonNegative(float x, float fallbackValue) {
    if (isnan(x) || isinf(x)) {
        return fallbackValue;
    }
    return max(x, 0.0);
}

vec3 sanitizeColorNonNegative(vec3 c, vec3 fallbackValue) {
    vec3 outC;
    outC.x = sanitizeFiniteNonNegative(c.x, fallbackValue.x);
    outC.y = sanitizeFiniteNonNegative(c.y, fallbackValue.y);
    outC.z = sanitizeFiniteNonNegative(c.z, fallbackValue.z);
    return outC;
}

float safeLum(vec3 c) {
    return max(luminance(max(c, vec3(0.0))), 1e-6);
}

AsvgfMoments momentsFromLuminance(float l, float history) {
    AsvgfMoments m;
    m.m1 = l;
    m.m2 = l * l;
    m.m3 = m.m2 * l;
    m.history = history;
    return m;
}

AsvgfMoments decodeMoments(vec4 packed) {
    AsvgfMoments m;
    m.m1 = sanitizeFiniteNonNegative(packed.x, 0.0);
    m.m2 = sanitizeFiniteNonNegative(packed.y, 0.0);
    m.m3 = sanitizeFiniteNonNegative(packed.z, 0.0);
    m.history = clamp(sanitizeFiniteNonNegative(packed.w, 0.0), 0.0, DENOISER_ASVGF_TEMPORAL_HISTORY_MAX);
    return m;
}

vec4 encodeMoments(AsvgfMoments m) {
    return vec4(max(m.m1, 0.0), max(m.m2, 0.0), max(m.m3, 0.0), clamp(m.history, 0.0, DENOISER_ASVGF_TEMPORAL_HISTORY_MAX));
}

float disocclusionMetric(vec3 curr, vec3 hist) {
    float currL = safeLum(curr);
    float histL = safeLum(hist);
    float dLum = abs(currL - histL) / max(max(currL, histL), 1e-4);
    vec3 rel = abs(curr - hist) / max(max(curr, hist), vec3(1e-3));
    float dRgb = max(max(rel.r, rel.g), rel.b);
    return asvgfClamp01(mix(dLum, dRgb, 0.35));
}

vec3 clampLuminancePreserveHue(vec3 c, float targetLum) {
    vec3 safe = max(c, vec3(0.0));
    float lum = safeLum(safe);
    if (lum <= 1e-6) {
        return vec3(max(targetLum, 0.0));
    }
    return safe * (max(targetLum, 0.0) / lum);
}

vec3 clampHistoryToMoments(vec3 histColor, AsvgfMoments histMom, float confRaw, float disocc) {
#if DENOISER_ASVGF_HISTORY_CLAMP_ENABLE
    if (histMom.history < DENOISER_ASVGF_HISTORY_CLAMP_MIN_HISTORY) {
        return histColor;
    }

    float confNorm = (asvgfClamp01(confRaw) - DENOISER_ASVGF_CONFIDENCE_BLEND_MIN) /
                     max(DENOISER_ASVGF_CONFIDENCE_BLEND_MAX - DENOISER_ASVGF_CONFIDENCE_BLEND_MIN, 1e-4);
    float conf = pow(asvgfClamp01(confNorm), DENOISER_ASVGF_CONFIDENCE_POWER);
    float sigmaK = mix(DENOISER_ASVGF_HISTORY_CLAMP_SIGMA_MIN, DENOISER_ASVGF_HISTORY_CLAMP_SIGMA_MAX, conf);
    sigmaK *= mix(1.0, DENOISER_ASVGF_HISTORY_CLAMP_DISOCC_TIGHTEN, asvgfClamp01(disocc));

    float varianceAbs = max(histMom.m2 - histMom.m1 * histMom.m1, 0.0);
    float sigma = sqrt(varianceAbs);
    float lo = max(histMom.m1 - sigmaK * sigma, 0.0);
    float hi = max(histMom.m1 + sigmaK * sigma, lo + 1e-5);

    float histLum = safeLum(histColor);
    float clampedLum = clamp(histLum, lo, hi);
    return clampLuminancePreserveHue(histColor, clampedLum);
#else
    return histColor;
#endif
}

void processLobeTemporal(
    vec3 currColor,
    vec3 histColor,
    AsvgfMoments currMom,
    AsvgfMoments histMom,
    float confidence,
    float disocclusion,
    out vec3 outColor,
    out AsvgfMoments outMom,
    out float outVariance,
    out float outAlpha
){
    float confRaw = asvgfClamp01(confidence);
    float confInfluence = asvgfClamp01(confRaw * DENOISER_ASVGF_CONFIDENCE_INFLUENCE_SCALE);
    currColor = sanitizeColorNonNegative(currColor, vec3(0.0));
    histColor = sanitizeColorNonNegative(histColor, currColor);

    float alphaHistory = 1.0 / max(histMom.history + 1.0, 1.0);
    float alpha = clamp(alphaHistory, DENOISER_ASVGF_TEMPORAL_ALPHA_MIN, DENOISER_ASVGF_TEMPORAL_ALPHA_MAX);

    vec3 histClamped = clampHistoryToMoments(histColor, histMom, confInfluence, disocclusion);
    histClamped = sanitizeColorNonNegative(histClamped, currColor);
    float historyLum = safeLum(histClamped);
    float currLum = safeLum(currColor);
    float fireflyLimit = max(0.2, historyLum * 1.5);
    vec3 currFireflyClamped = clampLuminancePreserveHue(currColor, min(currLum, fireflyLimit));
    currFireflyClamped = sanitizeColorNonNegative(currFireflyClamped, currColor);

    bool hasValidHistory = (histMom.history >= 1.0) && (historyLum > 1e-5);
    if (!hasValidHistory) {
        outColor = currFireflyClamped;
        outMom = currMom;
        outMom.history = 1.0;
        outVariance = VARIANCE_MIN;
        outAlpha = 1.0;
        return;
    }

    float confResetWidth = max(DENOISER_ASVGF_HISTORY_RESET_CONFIDENCE, 1e-4);
    float softReset = 1.0 - smoothstep(0.0, confResetWidth, confInfluence);
    float alphaSoft = mix(alpha, 1.0, softReset);

    outColor = mix(histClamped, currFireflyClamped, alphaSoft);
    outMom.m1 = mix(histMom.m1, currMom.m1, alphaSoft);
    outMom.m2 = mix(histMom.m2, currMom.m2, alphaSoft);
    outMom.m3 = mix(histMom.m3, currMom.m3, alphaSoft);
    float historyMixed = mix(min(histMom.history + 1.0, DENOISER_ASVGF_TEMPORAL_HISTORY_MAX), 1.0, softReset);
    outMom.history = max(historyMixed, 1.0);
    outAlpha = alphaSoft;

    float varianceAbs = max(outMom.m2 - outMom.m1 * outMom.m1, 0.0);
    float varianceNorm = varianceAbs / max(outMom.m1 * outMom.m1, 1e-4);
    float centeredM3 = outMom.m3 - 3.0 * outMom.m1 * outMom.m2 + 2.0 * outMom.m1 * outMom.m1 * outMom.m1;
    float skewNorm = abs(centeredM3) / max(outMom.m1 * outMom.m1 * outMom.m1, 1e-4);
    float shortHistory = 1.0 - asvgfClamp01(outMom.history / max(DENOISER_ASVGF_TEMPORAL_HISTORY_STABLE, 1.0));
    float temporalTrust = confInfluence;
    float varianceFloor = mix(
        DENOISER_ASVGF_VARIANCE_FLOOR_MIN,
        DENOISER_ASVGF_VARIANCE_FLOOR_MAX,
        asvgfClamp01((1.0 - temporalTrust) * 0.55 + shortHistory * 0.35 + asvgfClamp01(skewNorm * DENOISER_ASVGF_SKEW_GUARD_SCALE) * 0.10)
    );
    outVariance = clamp(max(varianceNorm, varianceFloor), VARIANCE_MIN, VARIANCE_MAX);
    outColor = sanitizeColorNonNegative(outColor, currFireflyClamped);
}

float confidenceToDebugView(float c) {
    return clamp(c, 0.0, 1.0);
}

vec3 confidenceDebugColor(float c) {
    float v = confidenceToDebugView(c);
    return vec3(v);
}

bool gatherBilinearTaps(
    vec2 reproj_uv,
    ivec2 res,
    vec3 center_pos,
    vec3 center_geom_normal,
    float inv_center_dist,
    float world_texel_size,
    out ivec2 taps[4],
    out float weights[4])
{
    const ivec2 base = ivec2(floor(reproj_uv));
    const vec2 frac_uv = fract(reproj_uv);

    taps[0] = base + ivec2(0, 0);
    taps[1] = base + ivec2(1, 0);
    taps[2] = base + ivec2(0, 1);
    taps[3] = base + ivec2(1, 1);

    weights[0] = (1.0 - frac_uv.x) * (1.0 - frac_uv.y);
    weights[1] = frac_uv.x * (1.0 - frac_uv.y);
    weights[2] = (1.0 - frac_uv.x) * frac_uv.y;
    weights[3] = frac_uv.x * frac_uv.y;

    float weight_sum = 0.0;
    for (int i = 0; i < 4; ++i) {
        if (any(lessThan(taps[i], ivec2(0))) || any(greaterThanEqual(taps[i], res))) {
            weights[i] = 0.0;
        } else {
            const vec3 p1 = imageLoad(geometry_prev_position, taps[i]).xyz;
            const float wp = positionEdgeStopWithWorldTexel(
                p1 - center_pos,
                center_geom_normal,
                inv_center_dist,
                DENOISER_POSITION_PLANE_THRESHOLD,
                world_texel_size
            );
            if (wp == 0.0) {
                weights[i] = 0.0;
            }
        }
        weight_sum += weights[i];
    }

    if (weight_sum <= 0.0) {
        return false;
    }

    for (int i = 0; i < 4; ++i) {
        weights[i] /= weight_sum;
    }

    return true;
}

bool gatherNearestTap(vec2 reproj_uv, ivec2 res, out ivec2 tap)
{
    tap = ivec2(floor(reproj_uv + vec2(0.5)));
    return all(greaterThanEqual(tap, ivec2(0))) && all(lessThan(tap, res));
}

vec4 loadBilinearPrevTemporalDiffuse(ivec2 taps[4], float weights[4])
{
    vec4 result = vec4(0.0);
    for (int i = 0; i < 4; ++i) {
        if (weights[i] > 0.0) {
            result += imageLoad(prev_temporal_asvgf_diffuse, taps[i]) * weights[i];
        }
    }
    return result;
}

